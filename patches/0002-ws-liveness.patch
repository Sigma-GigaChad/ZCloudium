diff --git a/packages/server/src/wsLiveness.ts b/packages/server/src/wsLiveness.ts
new file mode 100644
index 00000000..83a171a2
--- /dev/null
+++ b/packages/server/src/wsLiveness.ts
@@ -0,0 +1,70 @@
+/**
+ * wsLiveness — surveillance d'une socket WebSocket côté serveur via ping/pong.
+ *
+ * Chaque `intervalMs`, un ping est envoyé et le drapeau vivant est réarmé :
+ * si aucun pong n'est arrivé depuis le ping précédent, la socket est terminée.
+ * C'est le pattern canonique de la lib `ws` pour détecter et purger les
+ * connexions devenues muettes (client parti sans close, NAT évaporé) — les
+ * navigateurs répondent pong automatiquement au niveau protocole. L'événement
+ * `close` ou `stop()` arrête toute surveillance.
+ */
+
+export interface WsLike {
+  ping(): void;
+  terminate(): void;
+  on(event: string, listener: () => void): unknown;
+}
+
+export interface WsLivenessOptions {
+  intervalMs?: number;
+}
+
+export interface WsLivenessHandle {
+  stop(): void;
+}
+
+// zcloudium: défaut 30 s, cohérent avec les tests et les conventions serveur.
+const DEFAULT_INTERVAL_MS = 30000;
+
+export function attachWsLiveness(
+  ws: WsLike,
+  options: WsLivenessOptions = {},
+): WsLivenessHandle {
+  const intervalMs = options.intervalMs ?? DEFAULT_INTERVAL_MS;
+  let stopped = false;
+  let isAlive = true;
+
+  const cleanup = () => {
+    stopped = true;
+    clearInterval(timer);
+  };
+
+  const timer = setInterval(() => {
+    if (stopped) {
+      return;
+    }
+    if (!isAlive) {
+      cleanup();
+      ws.terminate();
+      return;
+    }
+    isAlive = false;
+    ws.ping();
+  }, intervalMs);
+
+  const onPong = () => {
+    isAlive = true;
+  };
+  const onClose = () => {
+    cleanup();
+  };
+
+  ws.on("pong", onPong);
+  ws.on("close", onClose);
+
+  return {
+    stop() {
+      cleanup();
+    },
+  };
+}
