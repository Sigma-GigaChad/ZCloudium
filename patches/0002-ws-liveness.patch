diff --git a/packages/web/src/wsWatchdog.ts b/packages/web/src/wsWatchdog.ts
new file mode 100644
index 00000000..f6235147
--- /dev/null
+++ b/packages/web/src/wsWatchdog.ts
@@ -0,0 +1,97 @@
+/**
+ * wsWatchdog — surveillance de connexion WebSocket côté client via sondes
+ * périodiques. Chaque `intervalMs`, une sonde est lancée. Si elle met plus
+ * de `timeoutMs` à répondre, ou rejette, la connexion est déclarée morte et
+ * `onDead` est appelé (une seule fois). Dès que `onDead` a été appelé, le
+ * watchdog s'arrête de lui-même. `stop()` interrompt tout de façon idempotente.
+ */
+
+export interface WsWatchdogOptions {
+  probe: () => Promise<unknown>;
+  onDead: () => void;
+  intervalMs?: number;
+  timeoutMs?: number;
+}
+
+export interface WsWatchdogHandle {
+  stop(): void;
+}
+
+// zcloudium: défauts 25 s / 10 s, cohérents avec les tests.
+const DEFAULT_INTERVAL_MS = 25000;
+const DEFAULT_TIMEOUT_MS = 10000;
+
+export function startWsWatchdog(options: WsWatchdogOptions): WsWatchdogHandle {
+  const intervalMs = options.intervalMs ?? DEFAULT_INTERVAL_MS;
+  const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+  let stopped = false;
+  let deadFired = false;
+
+  const teardown = () => {
+    stopped = true;
+    clearInterval(intervalHandle);
+  };
+
+  const fireDead = () => {
+    if (stopped || deadFired) {
+      return;
+    }
+    deadFired = true;
+    teardown();
+    options.onDead();
+  };
+
+  const tick = () => {
+    if (stopped) {
+      return;
+    }
+    let timeoutHandle: ReturnType<typeof setTimeout> | undefined;
+    let settled = false;
+
+    try {
+      options.probe().then(
+        () => {
+          if (settled) {
+            return;
+          }
+          settled = true;
+          if (timeoutHandle !== undefined) {
+            clearTimeout(timeoutHandle);
+          }
+        },
+        () => {
+          if (settled) {
+            return;
+          }
+          settled = true;
+          if (timeoutHandle !== undefined) {
+            clearTimeout(timeoutHandle);
+          }
+          fireDead();
+        },
+      );
+    } catch {
+      if (!settled) {
+        settled = true;
+        fireDead();
+      }
+      return;
+    }
+
+    timeoutHandle = setTimeout(() => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      fireDead();
+    }, timeoutMs);
+  };
+
+  const intervalHandle = setInterval(tick, intervalMs);
+
+  return {
+    stop() {
+      teardown();
+    },
+  };
+}
