+/**
+ * Tests du module wsWatchdog.ts — surveillance de connexion WebSocket côté
+ * client via sondes périodiques (timeout ou rejet de la sonde = connexion
+ * morte, onDead appelé une seule fois, stop() idempotent).
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import type { WsWatchdogOptions } from "../src/wsWatchdog.ts";
+
+interface Deferred<T> {
+  promise: Promise<T>;
+  resolve: (value: T) => void;
+  reject: (reason?: unknown) => void;
+}
+
+function createDeferred<T>(): Deferred<T> {
+  let resolve!: (value: T) => void;
+  let reject!: (reason?: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+describe("startWsWatchdog", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
