diff --git a/packages/server/test/wsLiveness.test.ts b/packages/server/test/wsLiveness.test.ts
new file mode 100644
index 00000000..788ff2aa
--- /dev/null
+++ b/packages/server/test/wsLiveness.test.ts
@@ -0,0 +1,155 @@
+/**
+ * Tests du module wsLiveness.ts — surveillance de socket WebSocket serveur
+ * via ping/pong (pattern canonique de la lib ws : le drapeau vivant est
+ * réarmé à chaque ping, un ping resté sans pong termine la socket).
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import type { WsLike, WsLivenessHandle } from "../src/wsLiveness.ts";
+
+class FakeWs implements WsLike {
+  pingCount = 0;
+  terminateCount = 0;
+  private listeners = new Map<string, Array<() => void>>();
+
+  ping(): void {
+    this.pingCount++;
+  }
+
+  terminate(): void {
+    this.terminateCount++;
+  }
+
+  on(event: string, listener: () => void): unknown {
+    if (!this.listeners.has(event)) {
+      this.listeners.set(event, []);
+    }
+    this.listeners.get(event)!.push(listener);
+    return this;
+  }
+
+  emit(event: string): void {
+    const handlers = this.listeners.get(event);
+    if (handlers) {
+      handlers.forEach((h) => h());
+    }
+  }
+}
+
+describe("attachWsLiveness", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("envoie un ping à chaque intervalle", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    attachWsLiveness(ws, { intervalMs });
+
+    expect(ws.pingCount).toBe(0);
+
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(1);
+
+    // Un pong entre les deux avances : sans lui, la socket serait terminée
+    // au deuxième tick (c'est le contrat du module).
+    ws.emit("pong");
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(2);
+  });
+
+  it("termine la socket après un intervalle sans pong", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    attachWsLiveness(ws, { intervalMs });
+
+    // Premier ping
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(1);
+    expect(ws.terminateCount).toBe(0);
+
+    // Pas de pong envoyé → au tick suivant, la socket doit être terminée
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.terminateCount).toBe(1);
+  });
+
+  it("reste en vie tant que chaque ping reçoit son pong", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    attachWsLiveness(ws, { intervalMs });
+
+    // Ping → pong à chaque cycle : la socket reste vivante indéfiniment.
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(1);
+    ws.emit("pong");
+
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.terminateCount).toBe(0);
+    expect(ws.pingCount).toBe(2);
+    ws.emit("pong");
+
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.terminateCount).toBe(0);
+    expect(ws.pingCount).toBe(3);
+  });
+
+  it("termine la socket dès qu'un ping reste sans pong", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    attachWsLiveness(ws, { intervalMs });
+
+    // Un pong au premier cycle, puis plus rien : le cycle suivant meurt.
+    vi.advanceTimersByTime(intervalMs);
+    ws.emit("pong");
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.terminateCount).toBe(0);
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.terminateCount).toBe(1);
+  });
+
+  it("stop() arrête les pings", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    const handle: WsLivenessHandle = attachWsLiveness(ws, { intervalMs });
+
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(1);
+
+    handle.stop();
+
+    // Même après plusieurs intervalles, plus de pings
+    vi.advanceTimersByTime(intervalMs * 3);
+    expect(ws.pingCount).toBe(1);
+  });
+
+  it("l'événement close arrête tout", async () => {
+    const { attachWsLiveness } = await import("../src/wsLiveness.ts");
+    const ws = new FakeWs();
+    const intervalMs = 30000;
+
+    attachWsLiveness(ws, { intervalMs });
+
+    vi.advanceTimersByTime(intervalMs);
+    expect(ws.pingCount).toBe(1);
+
+    ws.emit("close");
+
+    // Plus de pings après close
+    vi.advanceTimersByTime(intervalMs * 3);
+    expect(ws.pingCount).toBe(1);
+    expect(ws.terminateCount).toBe(0);
+  });
+});
