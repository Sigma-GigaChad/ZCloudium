@@ -0,0 +1,211 @@
+/**
+ * zcloudium: tests for staticAssets.ts — Content-Encoding negotiation (br
+ * preferred over gz on equal quality, q-values honoured), variants compressed
+ * once per file per process (cache keyed by path + mtime), Vary:
+ * Accept-Encoding, and weak ETag + 304 for index.html. Hashed assets stay
+ * `immutable` with no ETag; without Accept-Encoding the served body is
+ * byte-identical to upstream's raw readFile.
+ */
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { brotliDecompress, gunzip } from "node:zlib";
+import { promisify } from "node:util";
+import { randomBytes } from "node:crypto";
+import { mkdir, mkdtemp, readFile, rm, utimes, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { negotiateEncoding, serveStaticAsset } from "../src/staticAssets.ts";
+
+const brotliDecompressAsync = promisify(brotliDecompress);
+const gunzipAsync = promisify(gunzip);
+
+// Large repetitive texts: compressible, above the 1 KiB threshold.
+const BIG_SOURCE = `// fake bundle\nconsole.log("${"x".repeat(4096)}");\n`;
+const INDEX_SOURCE = `<!doctype html><html><body><div id="root"></div>${"<p>zcloudium</p>".repeat(200)}</body></html>`;
+const TINY_SOURCE = "console.log('tiny');";
+const NOISE_SOURCE = randomBytes(4096);
+
+describe("negotiateEncoding", () => {
+  it("prefers br when the client accepts both at equal quality", () => {
+    expect(negotiateEncoding("gzip, deflate, br")).toBe("br");
