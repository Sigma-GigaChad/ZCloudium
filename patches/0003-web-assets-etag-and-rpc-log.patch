+  it("treats q=0 as an explicit refusal", () => {
+    expect(negotiateEncoding("br;q=0, gzip")).toBe("gz");
+    expect(negotiateEncoding("br;q=0, gzip;q=0")).toBeNull();
+    expect(negotiateEncoding("gzip;q=0.5, *;q=0")).toBe("gz");
+  });
+
+  it("accepts through the * wildcard only what is not listed explicitly", () => {
+    expect(negotiateEncoding("*")).toBe("br");
+    expect(negotiateEncoding("gzip, *;q=0")).toBe("gz");
+    expect(negotiateEncoding("*;q=0")).toBeNull();
+  });
+
+  it("without the header (or identity alone) no encoding is acceptable", () => {
+    expect(negotiateEncoding(undefined)).toBeNull();
+    expect(negotiateEncoding("")).toBeNull();
+    expect(negotiateEncoding("identity")).toBeNull();
+  });
+
+  it("an unreadable q does not open the encoding", () => {
+    expect(negotiateEncoding("br;q=bogus")).toBeNull();
+    expect(negotiateEncoding("br;q=0.5, gzip;q=oops")).toBe("br");
+  });
+});
