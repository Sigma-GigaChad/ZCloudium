diff --git a/packages/server/src/staticAssets.ts b/packages/server/src/staticAssets.ts
new file mode 100644
index 00000000..58245ecd
--- /dev/null
+++ b/packages/server/src/staticAssets.ts
@@ -0,0 +1,258 @@
+import { readFile, stat } from "node:fs/promises";
+import { extname } from "node:path";
+import { brotliCompress, constants as zlibConstants, gzip } from "node:zlib";
+
+/**
+ * zcloudium: static-asset service for the web bundle.
+ *
+ * The runtime used to read the whole file from disk on every request and send
+ * it raw, with no validator for index.html. This module keeps the bytes in an
+ * in-process cache keyed by path + mtime, compresses each eligible file once
+ * per process (brotli preferred, gzip fallback, both served with `Vary`), and
+ * answers `304` for `index.html` revalidation. Nothing is written back to
+ * disk: the deployed image tree stays read-only-safe.
+ *
+ * Without `Accept-Encoding` the bytes served are exactly the upstream bytes,
+ * so a client that never negotiated an encoding sees today's response body.
+ */
+
+export type StaticEncoding = "br" | "gz";
+
+/** Bytes of an asset: readFile/zlib hand back Uint8Array backed by ArrayBuffer. */
+export type StaticAssetBytes = Uint8Array<ArrayBuffer>;
+
+const CONTENT_ENCODING: Record<StaticEncoding, string> = { br: "br", gz: "gzip" };
+
+/** Accept-Encoding token per internal encoding (gz ⇄ gzip). */
+const ENCODING_TOKEN: Record<StaticEncoding, string> = { br: "br", gz: "gzip" };
+
+// Below this size an encoding header costs more than it saves; the real web
+// bundle (JS/CSS/HTML) is always far above it.
+const MIN_COMPRESS_BYTES = 1024;
+
+// Text-ish extensions only: png/woff2 & co are already compressed, retrying
+// them wastes CPU for a bigger body.
+const COMPRESSIBLE_EXTENSIONS = new Set([
+  ".css",
+  ".html",
+  ".js",
+  ".json",
+  ".map",
+  ".mjs",
+  ".svg",
+  ".txt",
+  ".wasm",
+]);
+
+interface CachedStaticAsset {
+  /** Raw file bytes, read once per (path, mtime). */
+  raw: StaticAssetBytes;
+  /**
+   * Compressed variants, computed on first demand. `null` means compression
+   * produced a bigger body: the raw bytes stay the only sensible answer and
+   * the decision is remembered instead of retried.
+   */
+  variants: Map<StaticEncoding, StaticAssetBytes | null>;
+  /** Weak validator derived from size + mtime (index.html only). */
+  etag: string;
+  /** Whether this file is worth compressing at all. */
+  compressible: boolean;
+}
+
+// Entries are never evicted: the web bundle is bounded by its build manifest
+// and a redeploy restarts the process. A stale (path, mtime) key is simply
+// never requested again.
+const assetCache = new Map<string, CachedStaticAsset>();
+
+export interface StaticAssetRequest {
+  acceptEncoding?: string | undefined;
+  ifNoneMatch?: string | undefined;
+}
+
+export interface StaticAssetResult {
+  status: 200 | 304;
+  headers: Record<string, string>;
+  /** Absent on 304 (no body). */
+  body?: StaticAssetBytes;
+}
+
+/**
+ * Picks the response encoding from an `Accept-Encoding` header: q-values are
+ * honoured, `q=0` is an explicit refusal, `*` covers codings not listed, and
+ * brotli wins ties because it is the more compact of the two.
+ */
+export function negotiateEncoding(acceptEncoding: string | undefined): StaticEncoding | null {
+  if (!acceptEncoding) {
+    return null;
+  }
+  const qualities = new Map<string, number>();
+  let wildcard: number | undefined;
+  for (const entry of acceptEncoding.split(",")) {
+    const [coding = "", ...params] = entry.split(";");
+    const name = coding.trim().toLowerCase();
+    if (!name) {
+      continue;
+    }
+    let quality = 1;
+    for (const param of params) {
+      const [key = "", value = ""] = param.split("=");
+      if (key.trim().toLowerCase() === "q") {
+        const parsed = Number.parseFloat(value.trim());
+        // An unreadable q closes the coding: refusal is the safe default.
+        quality = Number.isFinite(parsed) ? parsed : 0;
+      }
+    }
+    if (name === "*") {
+      wildcard = quality;
+    } else {
+      qualities.set(name, quality);
+    }
+  }
+  let best: StaticEncoding | null = null;
+  let bestQuality = 0;
+  // brotli first: on equal quality it is the better representation.
+  for (const candidate of ["br", "gz"] as const) {
+    const quality = qualities.get(ENCODING_TOKEN[candidate]) ?? wildcard ?? 0;
+    if (quality > bestQuality) {
+      best = candidate;
+      bestQuality = quality;
+    }
+  }
+  return best;
+}
+
+/**
+ * Weak comparison against an `If-None-Match` header: exact tag, tag inside a
+ * list, or `*` all revalidate. `W/` is irrelevant for `If-None-Match`.
+ */
+export function etagMatches(ifNoneMatch: string | undefined, etag: string): boolean {
+  if (!ifNoneMatch) {
+    return false;
+  }
+  const target = opaqueTag(etag);
+  return ifNoneMatch.split(",").some((candidate) => {
+    const tag = candidate.trim();
+    return tag === "*" || opaqueTag(tag) === target;
+  });
+}
+
+function opaqueTag(tag: string): string {
+  const trimmed = tag.trim();
+  return trimmed.startsWith("W/") ? trimmed.slice(2) : trimmed;
+}
+
+function weakEtagFor(size: number, mtimeMs: number): string {
+  // Second and byte precision is enough for a validator: a rebuild that kept
+  // both the size and the mtime would still be a different file on disk.
+  return `W/"${size.toString(16)}-${Math.floor(mtimeMs).toString(16)}"`;
+}
+
+function compressBytes(encoding: StaticEncoding, input: StaticAssetBytes): Promise<StaticAssetBytes> {
+  return new Promise<StaticAssetBytes>((resolve, reject) => {
+    if (encoding === "br") {
+      // Quality 5: the first load is a one-off cost and quality 11 buys a few
+      // percent for a lot of blocked event-loop time.
+      brotliCompress(
+        input,
+        {
+          params: {
+            [zlibConstants.BROTLI_PARAM_QUALITY]: 5,
+            [zlibConstants.BROTLI_PARAM_SIZE_HINT]: input.byteLength,
+          },
+        },
+        (error, result) => {
+          if (error) {
+            reject(error);
+            return;
+          }
+          resolve(result);
+        },
+      );
+      return;
+    }
+    gzip(input, { level: 6 }, (error, result) => {
+      if (error) {
+        reject(error);
+        return;
+      }
+      resolve(result);
+    });
+  });
+}
+
+async function compressedVariant(
+  entry: CachedStaticAsset,
+  encoding: StaticEncoding,
+): Promise<StaticAssetBytes | null> {
+  const cached = entry.variants.get(encoding);
+  if (cached !== undefined) {
+    return cached;
+  }
+  const compressed = await compressBytes(encoding, entry.raw);
+  const variant = compressed.byteLength < entry.raw.byteLength ? compressed : null;
+  entry.variants.set(encoding, variant);
+  return variant;
+}
+
+/**
+ * Builds the response description for one static file request, or `null` when
+ * the file is gone (the caller keeps its 404 semantics). The caller owns the
+ * `Content-Type` header; this module only owns caching, encoding and
+ * cache-validity headers.
+ */
+export async function serveStaticAsset(
+  filePath: string,
+  request: StaticAssetRequest = {},
+): Promise<StaticAssetResult | null> {
+  let info;
+  try {
+    info = await stat(filePath);
+  } catch {
+    return null;
+  }
+  if (!info.isFile()) {
+    return null;
+  }
+
+  const cacheKey = `${filePath}\u0000${info.mtimeMs}:${info.size}`;
+  let entry = assetCache.get(cacheKey);
+  if (!entry) {
+    entry = {
+      raw: await readFile(filePath),
+      variants: new Map(),
+      etag: weakEtagFor(info.size, info.mtimeMs),
+      compressible:
+        info.size >= MIN_COMPRESS_BYTES &&
+        COMPRESSIBLE_EXTENSIONS.has(extname(filePath).toLowerCase()),
+    };
+    assetCache.set(cacheKey, entry);
+  }
+
+  const isIndex = filePath.endsWith("index.html");
+  const headers: Record<string, string> = {
+    "Cache-Control": isIndex ? "no-cache" : "public, max-age=31536000, immutable",
+  };
+  if (entry.compressible) {
+    // Set on the identity answer too: a shared cache must know the
+    // representation depends on Accept-Encoding.
+    headers.Vary = "Accept-Encoding";
+  }
+  if (isIndex) {
+    headers.ETag = entry.etag;
+    if (etagMatches(request.ifNoneMatch, entry.etag)) {
+      return { status: 304, headers };
+    }
+  }
+
+  if (entry.compressible) {
+    const encoding = negotiateEncoding(request.acceptEncoding);
+    if (encoding) {
+      const variant = await compressedVariant(entry, encoding);
+      if (variant) {
+        headers["Content-Encoding"] = CONTENT_ENCODING[encoding];
+        return { status: 200, headers, body: variant };
+      }
+    }
+  }
+  return { status: 200, headers, body: entry.raw };
+}
