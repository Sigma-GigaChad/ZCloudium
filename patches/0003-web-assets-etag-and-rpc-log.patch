+    const encodedFirst = await serveStaticAsset(file, { acceptEncoding: "br" });
+    const encodedSecond = await serveStaticAsset(file, { acceptEncoding: "br" });
+    // Same instance = compression ran once per process.
+    expect(encodedSecond?.body).toBe(encodedFirst?.body);
+
+    // Different mtime → new entry, content read again.
+    const later = new Date(Date.now() + 5000);
