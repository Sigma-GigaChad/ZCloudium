+  it("reads the file once and reuses the compressed variant (key: path + mtime)", async () => {
+    const file = join(root, "assets", "cache-abc123.js");
+    const rawFirst = await serveStaticAsset(file, {});
+    const rawSecond = await serveStaticAsset(file, {});
