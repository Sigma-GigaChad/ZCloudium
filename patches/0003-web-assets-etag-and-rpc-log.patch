+/**
+ * zcloudium: end-to-end test of staticAssets.ts wired into http.ts —
+ * negotiated Content-Encoding (br/gzip) + Vary, ETag/304 for index.html (direct
+ * path and SPA fallback), and an unchanged body without Accept-Encoding. Raw
+ * node:http client: no implicit decompression, the bytes on the wire are
+ * inspected as-is.
+ */
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { brotliDecompress, gunzip } from "node:zlib";
+import { promisify } from "node:util";
+import { request as httpRequest, type IncomingHttpHeaders, type Server } from "node:http";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AddressInfo } from "node:net";
+import { ServiceCollection } from "@zcode/services";
+import { createHttpServer } from "../src/http.ts";
+
+const brotliDecompressAsync = promisify(brotliDecompress);
+const gunzipAsync = promisify(gunzip);
+
+const APP_SOURCE = `console.log("${"y".repeat(4096)}");\n`;
+const INDEX_SOURCE = `<!doctype html><html><body><div id="root"></div>${"<p>zcloudium</p>".repeat(200)}</body></html>`;
+
+let server: Server;
+let port: number;
+let staticRoot: string;
+
+beforeAll(async () => {
+  staticRoot = await mkdtemp(join(tmpdir(), "zcloudium-static-http-"));
+  await mkdir(join(staticRoot, "assets"), { recursive: true });
+  await writeFile(join(staticRoot, "index.html"), INDEX_SOURCE);
+  await writeFile(join(staticRoot, "assets", "app-abc123.js"), APP_SOURCE);
+
+  server = createHttpServer(new ServiceCollection(), 0, { staticRoot, spaFallback: true });
+  port = (server.address() as AddressInfo).port;
+});
+
+afterAll(async () => {
+  await new Promise<void>((resolve, reject) => {
+    server.close((error) => (error ? reject(error) : resolve()));
+  });
+  await rm(staticRoot, { recursive: true, force: true });
+});
+
+function httpGet(
+  path: string,
+  headers: Record<string, string> = {},
+): Promise<{ status: number; headers: IncomingHttpHeaders; body: Buffer }> {
+  return new Promise((resolve, reject) => {
+    const request = httpRequest(
+      {
+        host: "127.0.0.1",
+        port,
+        path,
+        method: "GET",
+        headers: { connection: "close", ...headers },
+      },
+      (response) => {
+        const chunks: Buffer[] = [];
+        response.on("data", (chunk: Buffer) => chunks.push(chunk));
+        response.on("end", () =>
+          resolve({
+            status: response.statusCode ?? 0,
+            headers: response.headers,
+            body: Buffer.concat(chunks),
+          }),
+        );
+      },
+    );
+    request.on("error", reject);
+    request.end();
+  });
+}
+
+describe("static assets over HTTP", () => {
+  it("serves br when the client accepts it, with Vary", async () => {
+    const response = await httpGet("/assets/app-abc123.js", {
+      "accept-encoding": "gzip, deflate, br",
+    });
+    expect(response.status).toBe(200);
+    expect(response.headers["content-encoding"]).toBe("br");
+    expect(response.headers.vary).toContain("Accept-Encoding");
+    expect(await brotliDecompressAsync(response.body)).toEqual(Buffer.from(APP_SOURCE));
+  });
+
+  it("honours q-values (gzip when the client prefers it)", async () => {
+    const response = await httpGet("/assets/app-abc123.js", {
+      "accept-encoding": "br;q=0.2, gzip;q=0.9",
+    });
+    expect(response.status).toBe(200);
+    expect(response.headers["content-encoding"]).toBe("gzip");
+    expect(await gunzipAsync(response.body)).toEqual(Buffer.from(APP_SOURCE));
+  });
+
+  it("without Accept-Encoding the body is identical to today's", async () => {
+    const response = await httpGet("/assets/app-abc123.js");
+    expect(response.status).toBe(200);
+    expect(response.headers["content-encoding"]).toBeUndefined();
+    expect(response.headers["content-type"]).toContain("text/javascript");
+    expect(response.body).toEqual(await readFile(join(staticRoot, "assets", "app-abc123.js")));
+  });
+
+  it("index.html answers 304 on If-None-Match, directly and through the SPA fallback", async () => {
+    const first = await httpGet("/");
+    expect(first.status).toBe(200);
+    expect(first.headers["cache-control"]).toBe("no-cache");
+    expect(first.headers["content-type"]).toContain("text/html");
+    const etag = first.headers.etag;
+    expect(etag).toBeTruthy();
+
+    const revalidated = await httpGet("/", { "if-none-match": String(etag) });
+    expect(revalidated.status).toBe(304);
+    expect(revalidated.body.byteLength).toBe(0);
+    expect(revalidated.headers.etag).toBe(etag);
+
+    const fallback = await httpGet("/workspaces/deep/link", {
+      "if-none-match": String(etag),
+    });
+    expect(fallback.status).toBe(304);
+  });
+});
