 export type RPCLogger = (message: string, ...args: unknown[]) => void;
 
+// ============================================================================
+// zcloudium: RPC log gate — quiet by default
+// ============================================================================
+
+/** Environment variable that re-enables the RPC log lines. */
+export const RPC_LOG_ENV = "ZCODE_RPC_LOG";
+
+/** Minimal env surface: this package is also bundled for the browser. */
+type RpcLogEnv = Record<string, string | undefined>;
+
+function readRpcLogEnv(): RpcLogEnv | undefined {
+  // No `process` global in a browser bundle: read it off globalThis.
+  return (globalThis as { process?: { env?: RpcLogEnv } }).process?.env;
+}
+
+/**
+ * zcloudium: this middleware writes a formatted line for every RPC call, on
+ * success and on failure — in a container that drowns stdout in per-call
+ * noise. The gate is off by default; `ZCODE_RPC_LOG=1` (or `true`, case and
+ * whitespace insensitive) restores the historical lines verbatim.
+ */
+export function isRpcLogEnabled(env: RpcLogEnv | undefined = readRpcLogEnv()): boolean {
+  const raw = env?.[RPC_LOG_ENV];
+  if (!raw) {
+    return false;
+  }
+  const normalized = raw.trim().toLowerCase();
+  return normalized === "1" || normalized === "true";
+}
+
+/**
+ * Wraps a logger so nothing is emitted while the gate is off. Call sites that
+ * want upstream's verbosity (desktop host, server-cli) keep their raw logger;
+ * the web server wraps its own (see packages/server/src/http.ts).
+ */
+export function gatedRpcLogger(logger: RPCLogger): RPCLogger {
+  return (message, ...args) => {
+    if (isRpcLogEnabled()) {
+      logger(message, ...args);
+    }
+  };
+}
+
