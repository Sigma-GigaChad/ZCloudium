@@ -0,0 +1,206 @@
+/**
+ * zcloudium: tests for the RPC log gate — the middleware emits one line per
+ * call (success and failure) which drowns stdout in a container; a logger
+ * wrapped by gatedRpcLogger is silent by default and ZCODE_RPC_LOG=1 restores
+ * the upstream lines verbatim. A failing call is still propagated while mute.
+ */
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { Event } from "../src/foundation.js";
+import {
+  gatedRpcLogger,
+  isRpcLogEnabled,
+  LoggingChannelClient,
+  LoggingChannelServer,
+} from "../src/logging-middleware.js";
+import type { IChannel, IChannelClient, IChannelServer, IServerChannel } from "../src/channels.js";
+
+const ENV_NAME = "ZCODE_RPC_LOG";
+let savedEnv: string | undefined;
+
+beforeEach(() => {
+  savedEnv = process.env[ENV_NAME];
+  delete process.env[ENV_NAME];
+});
+
+afterEach(() => {
+  if (savedEnv === undefined) {
+    delete process.env[ENV_NAME];
+  } else {
+    process.env[ENV_NAME] = savedEnv;
+  }
+});
+
+interface LogLine {
+  message: string;
+  args: unknown[];
+}
+
+function captureLogger(lines: LogLine[]): (message: string, ...args: unknown[]) => void {
+  return (message, ...args) => {
+    lines.push({ message, args });
+  };
+}
+
+function createServerWithGate(lines: LogLine[]): {
+  server: LoggingChannelServer<string>;
+  getRegistered: () => IServerChannel<string>;
+} {
+  let registered: IServerChannel<string> | undefined;
+  const innerServer: IChannelServer<string> = {
+    registerChannel(_channelName, channel) {
+      registered = channel;
+    },
+  };
+  const server = new LoggingChannelServer(innerServer, gatedRpcLogger(captureLogger(lines)));
+  return {
+    server,
+    getRegistered: () => {
+      if (!registered) {
+        throw new Error("channel not registered");
+      }
+      return registered;
+    },
+  };
+}
+
+function createClientWithGate(lines: LogLine[]): LoggingChannelClient {
+  const channel: IChannel = {
+    async call() {
+      return "ok";
+    },
+    listen() {
+      return Event.None;
+    },
+  };
+  const innerClient: IChannelClient = {
+    getChannel: () => channel,
+  };
+  return new LoggingChannelClient(innerClient, gatedRpcLogger(captureLogger(lines)));
+}
+
+describe("isRpcLogEnabled", () => {
+  it("is off by default and on negative values", () => {
+    expect(isRpcLogEnabled()).toBe(false);
+    expect(isRpcLogEnabled({})).toBe(false);
+    expect(isRpcLogEnabled({ [ENV_NAME]: "" })).toBe(false);
+    expect(isRpcLogEnabled({ [ENV_NAME]: "0" })).toBe(false);
+    expect(isRpcLogEnabled({ [ENV_NAME]: "false" })).toBe(false);
+  });
+
+  it("turns on with 1 or true, case and whitespace insensitive", () => {
+    expect(isRpcLogEnabled({ [ENV_NAME]: "1" })).toBe(true);
+    expect(isRpcLogEnabled({ [ENV_NAME]: "true" })).toBe(true);
+    expect(isRpcLogEnabled({ [ENV_NAME]: " TRUE " })).toBe(true);
+  });
+});
+
+describe("gatedRpcLogger", () => {
+  it("emits nothing by default", () => {
+    const lines: LogLine[] = [];
+    const logger = gatedRpcLogger(captureLogger(lines));
+    logger("[rpc:call] test.fail FAIL (0.1ms)", new Error("boom"));
+    expect(lines).toEqual([]);
+  });
+
+  it("ZCODE_RPC_LOG=1 restores the lines verbatim", () => {
+    process.env[ENV_NAME] = "1";
+    const lines: LogLine[] = [];
+    const logger = gatedRpcLogger(captureLogger(lines));
+    const error = new Error("boom");
+    logger("[rpc:call] test.fail FAIL (0.1ms)", error);
+    expect(lines).toEqual([{ message: "[rpc:call] test.fail FAIL (0.1ms)", args: [error] }]);
+  });
+});
+
+describe("LoggingChannelServer with the gate", () => {
+  it("is silent by default across register, call and listen", async () => {
+    const lines: LogLine[] = [];
+    const { server, getRegistered } = createServerWithGate(lines);
+    server.registerChannel("events", {
+      async call() {
+        return "ok";
+      },
+      listen() {
+        return Event.None;
+      },
+    });
+
+    const channel = getRegistered();
+    await channel.call("ctx", "ping");
+    await channel.call("ctx", "boom").catch(() => undefined);
+    channel.listen("ctx", "onData");
+
+    expect(lines).toEqual([]);
+  });
+
+  it("ZCODE_RPC_LOG=1 restores the upstream lines", async () => {
+    process.env[ENV_NAME] = "1";
+    const lines: LogLine[] = [];
+    const { server, getRegistered } = createServerWithGate(lines);
+    server.registerChannel("events", {
+      async call(_ctx, command) {
+        if (command === "boom") {
+          throw new Error("boom");
+        }
+        return "ok";
+      },
+      listen() {
+        return Event.None;
+      },
+    });
+
+    expect(lines[0]?.message).toBe('[rpc:register] channel "events"');
+
+    const channel = getRegistered();
+    await channel.call("ctx", "ping");
+    expect(
+      lines.some((line) => /^\[rpc:call\] events\.ping OK \(\d+\.\d+ms\)$/.test(line.message)),
+    ).toBe(true);
+
+    await channel.call("ctx", "boom").catch(() => undefined);
+    const failLine = lines.find((line) => line.message.startsWith("[rpc:call] events.boom FAIL "));
+    expect(failLine?.message).toMatch(/^\[rpc:call\] events\.boom FAIL \(\d+\.\d+ms\)$/);
+    expect(failLine?.args[0]).toBeInstanceOf(Error);
+
+    channel.listen("ctx", "onData");
+    expect(lines.some((line) => line.message === "[rpc:listen] events.onData subscribed")).toBe(
+      true,
+    );
+  });
+
+  it("a failing call is propagated even while the gate is mute", async () => {
+    const lines: LogLine[] = [];
+    const { server, getRegistered } = createServerWithGate(lines);
+    server.registerChannel("events", {
+      async call() {
+        throw new Error("boom");
+      },
+      listen() {
+        return Event.None;
+      },
+    });
+
+    await expect(getRegistered().call("ctx", "boom")).rejects.toThrow("boom");
+    expect(lines).toEqual([]);
+  });
+});
+
+describe("LoggingChannelClient with the gate", () => {
+  it("is silent by default and restored by ZCODE_RPC_LOG=1", async () => {
+    const silentLines: LogLine[] = [];
+    const silentClient = createClientWithGate(silentLines);
+    await silentClient.getChannel<IChannel>("workspace").call("open");
+    silentClient.getChannel<IChannel>("workspace").listen("onChange");
+    expect(silentLines).toEqual([]);
+
+    process.env[ENV_NAME] = "1";
+    const loudLines: LogLine[] = [];
+    const loudClient = createClientWithGate(loudLines);
+    await loudClient.getChannel<IChannel>("workspace").call("open");
+    expect(
+      loudLines.some((line) =>
+        /^\[rpc:call\] workspace\.open → OK \(\d+\.\d+ms\)$/.test(line.message),
+      ),
+    ).toBe(true);
+  });
+});
