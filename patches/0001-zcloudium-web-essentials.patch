diff --git a/packages/server/src/remoteSessionRegistry.ts b/packages/server/src/remoteSessionRegistry.ts
new file mode 100644
index 0000000..626bee6
--- /dev/null
+++ b/packages/server/src/remoteSessionRegistry.ts
@@ -0,0 +1,248 @@
+import { randomUUID } from "node:crypto";
+import type { WebSocket } from "ws";
+import type { RemoteTarget } from "@zcode/shared";
+import { buildSshRemoteHostKey } from "@zcode/shared";
+import type { RemoteConnection } from "./remote/index.js";
+
+/**
+ * Durable server-side remote sessions — the web counterpart of the desktop
+ * host's windowRemoteConnectionRegistry.
+ *
+ * The browser is disposable by design: it refreshes, it closes, the operator
+ * walks away for hours. The remote session (SSH backend + the runtime deployed
+ * on the target, where background tasks run) must NOT share that lifecycle.
+ * This registry therefore owns two layers, mirroring desktop:
+ *
+ * - live connections, keyed by target identity (an SSH channel is expensive:
+ *   reconnecting the same target reuses it instead of redeploying);
+ * - logical sessions, keyed by an unguessable id and scoped per workspace, each
+ *   multiplexed onto its connection and attached to zero or more browser
+ *   sockets at a time.
+ *
+ * Lifetimes: a session dies when the remote side closes (onDidRemoteClose —
+ * target rebooted, SSH cut), when the operator disposes it explicitly, or when
+ * this server restarts. A browser leaving never disposes anything.
+ */
+
+export interface RemoteSessionScope {
+  workspacePath?: string;
+  workspaceIdentity?: string;
+}
+
+interface ConnectionEntry {
+  connection: RemoteConnection;
+  fingerprint: string;
+  sessionIds: Set<string>;
+}
+
+interface SessionEntry {
+  id: string;
+  connection: RemoteConnection;
+  fingerprint: string;
+  scopeKey: string;
+  workspacePath?: string;
+  workspaceIdentity?: string;
+  sockets: Set<WebSocket>;
+}
+
+/** Target identity: what makes two connects "the same machine". */
+export function connectionFingerprint(target: RemoteTarget): string {
+  switch (target.kind) {
+    case "ssh":
+      // Same key desktop builds: host, port, user, key path — never the secret.
+      // `target` is already SSHConnectOptions when kind === "ssh"; passing it
+      // whole keeps the call aligned with buildSshRemoteHostKey's union.
+      return `ssh:${buildSshRemoteHostKey(target)}`;
+    case "wsl":
+      return `wsl:${target.distro ?? ""}:${target.user ?? ""}`;
+    case "docker":
+      // Desktop never reuses docker connections; neither do we.
+      return `docker:${randomUUID()}`;
+  }
+}
+
+export function scopeKeyFor(target: RemoteTarget, scope: RemoteSessionScope): string {
+  const workspace = scope.workspaceIdentity?.trim() || scope.workspacePath?.trim() || "";
+  return `${connectionFingerprint(target)}::${workspace}`;
+}
+
+export class RemoteSessionRegistry {
+  private readonly connections = new Map<string, ConnectionEntry>();
+  private readonly sessions = new Map<string, SessionEntry>();
+  private readonly inflight = new Map<string, Promise<{ id: string; reused: boolean }>>();
+  /** Connection creation per target: same-target connects with different workspace scopes race here. */
+  private readonly connecting = new Map<string, Promise<RemoteConnection>>();
+
+  /** A session that is already live for this exact scope: instant re-attach. */
+  findLiveSessionId(scopeKey: string): string | undefined {
+    for (const [id, session] of this.sessions) {
+      if (session.scopeKey === scopeKey) {
+        return id;
+      }
+    }
+    return undefined;
+  }
+
+  getSession(id: string): SessionEntry | undefined {
+    return this.sessions.get(id);
+  }
+
+  /**
+   * Connect, deduplicated: an existing live session for the scope wins, an
+   * in-flight connect is shared, a live connection for the same target is
+   * multiplexed, and only a genuinely new target opens a new SSH connection.
+   */
+  async connect(
+    target: RemoteTarget,
+    scope: RemoteSessionScope,
+    connect: (onDidRemoteClose: (code: number) => void) => Promise<RemoteConnection>,
+  ): Promise<{ id: string; reused: boolean }> {
+    const fingerprint = connectionFingerprint(target);
+    const scopeKey = scopeKeyFor(target, scope);
+
+    const existingSession = this.findLiveSessionId(scopeKey);
+    if (existingSession) {
+      return { id: existingSession, reused: true };
+    }
+
+    const inflight = this.inflight.get(scopeKey);
+    if (inflight) {
+      return { ...(await inflight), reused: true };
+    }
+
+    const creation = (async () => {
+      // A live connection for the same target multiplexes a new workspace scope
+      // without redeploying; only an unknown target opens a new SSH channel.
+      const cached = this.connections.get(fingerprint);
+      if (cached) {
+        const id = this.registerSession(cached, scope, scopeKey);
+        return { id, reused: true };
+      }
+
+      // Same-target connects racing on different scopes serialize here: one
+      // caller creates the SSH channel, the others multiplex onto it (reused).
+      // Without this, the loser's connections.set would orphan the winner's
+      // entry and strand its sessions with a map no cleanup path can reach.
+      let pending = this.connecting.get(fingerprint);
+      const isCreator = !pending;
+      if (!pending) {
+        let connection: RemoteConnection | undefined;
+        const onDidRemoteClose = () => {
+          if (connection) {
+            this.handleRemoteClose(connection);
+          }
+        };
+        pending = connect(onDidRemoteClose).then((value) => {
+          connection = value;
+          this.connections.set(fingerprint, {
+            connection,
+            fingerprint,
+            sessionIds: new Set(),
+          });
+          return connection;
+        });
+        // Detached cleanup: absorbs the rejection so a failed connect
+        // (unreachable host, auth, deploy) never becomes an unhandledRejection
+        // — there is no process-level handler, and every caller handles its own
+        // await of the scoped promise below.
+        void pending.finally(() => this.connecting.delete(fingerprint)).catch(() => undefined);
+        this.connecting.set(fingerprint, pending);
+      }
+      const connection = await pending;
+      const entry = this.connections.get(fingerprint);
+      if (!entry) {
+        // The remote died during the registration tick; its close already
+        // swept everything. The request fails, no state is corrupted.
+        throw new Error("Remote connection closed during connect");
+      }
+      const id = this.registerSession(entry, scope, scopeKey);
+      // reused=false only for the caller whose connect created the channel —
+      // the route wires the runtime-preferences bridge exactly once on that.
+      return { id, reused: !isCreator };
+    })().finally(() => this.inflight.delete(scopeKey));
+
+    this.inflight.set(scopeKey, creation);
+    return creation;
+  }
+
+  /** Attach a browser socket: its lifecycle no longer owns the session. */
+  attach(id: string, ws: WebSocket): boolean {
+    const session = this.sessions.get(id);
+    if (!session) {
+      return false;
+    }
+    session.sockets.add(ws);
+    ws.on("close", () => {
+      session.sockets.delete(ws);
+    });
+    return true;
+  }
+
+  /** Explicit disposal of one logical session; the SSH connection is kept cached (desktop parity). */
+  disposeSession(id: string): boolean {
+    const session = this.sessions.get(id);
+    if (!session) {
+      return false;
+    }
+    this.evictSession(session);
+    return true;
+  }
+
+  private registerSession(
+    entry: ConnectionEntry,
+    scope: RemoteSessionScope,
+    scopeKey: string,
+  ): string {
+    const id = randomUUID();
+    const session: SessionEntry = {
+      id,
+      connection: entry.connection,
+      fingerprint: entry.fingerprint,
+      scopeKey,
+      workspacePath: scope.workspacePath,
+      workspaceIdentity: scope.workspaceIdentity,
+      sockets: new Set(),
+    };
+    entry.sessionIds.add(id);
+    this.sessions.set(id, session);
+    return id;
+  }
+
+  private evictSession(session: SessionEntry): void {
+    for (const ws of session.sockets) {
+      ws.close();
+    }
+    session.sockets.clear();
+    this.sessions.delete(session.id);
+    this.connections.get(session.fingerprint)?.sessionIds.delete(session.id);
+  }
+
+  /** The remote side died (or the SSH channel did): everything downstream dies with it. */
+  private handleRemoteClose(connection: RemoteConnection): void {
+    // Sweep by identity, not only through the connections map: a connection
+    // orphaned by a lost race (before the defense above) must still take its
+    // sessions and its dispose with it instead of stranding them.
+    for (const [key, entry] of [...this.connections]) {
+      if (entry.connection === connection) {
+        this.connections.delete(key);
+      }
+    }
+    for (const session of [...this.sessions.values()]) {
+      if (session.connection !== connection) {
+        continue;
+      }
+      // Closing the sockets is how the browser learns the session is gone;
+      // the UI then offers a real reconnect.
+      for (const ws of session.sockets) {
+        ws.close();
+      }
+      session.sockets.clear();
+      this.sessions.delete(session.id);
+    }
+    try {
+      connection.dispose();
+    } catch (error) {
+      console.warn("[remote-session] dispose after remote close failed:", error);
+    }
+  }
+}
