diff --git a/packages/server/src/attachmentStage.ts b/packages/server/src/attachmentStage.ts
new file mode 100644
index 0000000..f80118a
--- /dev/null
+++ b/packages/server/src/attachmentStage.ts
@@ -0,0 +1,73 @@
+import { randomUUID } from "node:crypto";
+import { mkdir, writeFile } from "node:fs/promises";
+import { basename, extname, join } from "node:path";
+import type { Hono } from "hono";
+import { getZCodeDataRootDir } from "@zcode/services/node";
+
+/**
+ * Stage an attachment into the server's own filesystem.
+ *
+ * The web composer uploads bytes over this route instead of carrying a local
+ * path like the desktop does: the browser has no filesystem, and the agent
+ * runs on THIS machine, so a file written here is exactly what the desktop's
+ * temp-text writer produces on its host — a real, agent-readable path.
+ *
+ * Layout and permissions mirror the desktop writer deliberately:
+ * `{dataRoot}/tmp/paste-attachments/YYYY-MM-DD/<safe-name>-<uuid8><ext>`,
+ * directories 0700, files 0600. Staged files are the operator's own pasted or
+ * uploaded content, and must not become readable by anyone but the agent's
+ * user.
+ */
+
+/** Same ceiling as the chat upload protocol (attachmentMaxBytes, 20 MiB). */
+export const STAGE_MAX_BYTES = 20 * 1024 * 1024;
+
+const SAFE_NAME = /[^a-zA-Z0-9._-]+/g;
+
+export function sanitizeStagedFilename(raw: string): string {
+  const base = basename(String(raw ?? "")).trim() || "attachment";
+  const stem = base.slice(0, 64).replace(SAFE_NAME, "-").replace(/^[-.]+/, "") || "attachment";
+  const ext = extname(stem).slice(0, 16);
+  return `${stem.slice(0, stem.length - ext.length) || "attachment"}-${randomUUID().slice(0, 8)}${ext}`;
+}
+
+export function stagedAttachmentDir(now = new Date()): string {
+  const day = now.toISOString().slice(0, 10);
+  return join(getZCodeDataRootDir(), "tmp", "paste-attachments", day);
+}
+
+export async function stageAttachmentBytes(
+  name: string,
+  bytes: Uint8Array,
+): Promise<{ filename: string; path: string; sizeBytes: number }> {
+  if (bytes.byteLength > STAGE_MAX_BYTES) {
+    throw new Error(`Attachment exceeds the ${Math.floor(STAGE_MAX_BYTES / 1024 / 1024)} MiB web limit`);
+  }
+  const filename = sanitizeStagedFilename(name);
+  const dir = stagedAttachmentDir();
+  await mkdir(dir, { recursive: true, mode: 0o700 });
+  const path = join(dir, filename);
+  await writeFile(path, bytes, { mode: 0o600 });
+  return { filename, path, sizeBytes: bytes.byteLength };
+}
+
+export function registerAttachmentStageRoutes(app: Hono): void {
+  // The body is the raw file (octet-stream) or raw text; the query carries the
+  // client-side filename for extension and display. 413 past the protocol cap.
+  app.post("/api/stage-attachment", async (c) => {
+    const bytes = new Uint8Array(await c.req.arrayBuffer());
+    if (bytes.byteLength === 0) {
+      return c.json({ error: "Empty attachment" }, 400);
+    }
+    if (bytes.byteLength > STAGE_MAX_BYTES) {
+      return c.json({ error: `Attachment exceeds the ${Math.floor(STAGE_MAX_BYTES / 1024 / 1024)} MiB web limit` }, 413);
+    }
+    try {
+      const staged = await stageAttachmentBytes(c.req.query("name") ?? "attachment", bytes);
+      return c.json(staged);
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return c.json({ error: message }, 500);
+    }
+  });
+}
