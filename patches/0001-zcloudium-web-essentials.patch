@@ -0,0 +1,330 @@
+import {
+  createPrivateKey,
+  createPublicKey,
+  generateKeyPairSync,
+  type KeyObject,
+} from "node:crypto";
+import { readFileSync } from "node:fs";
+import { chmod, mkdir, readFile, stat as statFn, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { Hono } from "hono";
+import { getZCodeDataRootDir } from "@zcode/services/node";
+
+/**
+ * zcloudium: carte « machine courante » du wizard web — l'agent du conteneur
+ * se connecte en SSH à la machine Docker hôte pour accéder à sa CLI et à ses
+ * utilitaires. Le serveur détient la clé privée (jamais sortie du process),
+ * la clé publique doit être installée dans ~/.ssh/authorized_keys de la cible.
+ */
+
+const HOST_MACHINE_DIR_RELATIVE = "ssh/host-machine";
+const HOST_MACHINE_PRIVATE_KEY_NAME = "id_ed25519";
+const HOST_MACHINE_PUBLIC_KEY_NAME = "id_ed25519.pub";
+const HOST_MACHINE_KEY_COMMENT = "zcloudium-host-machine";
+
+/**
+ * isHostMachineEnabled : ON par défaut, opinionated ; seules les valeurs
+ * explicitement négatives de ZCLOUDIUM_HOST_MACHINE (insensible à la casse,
+ * trimmées) désactivent la carte. Un env vide ou absent laisse la feature active.
+ */
+export function isHostMachineEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  const raw = env.ZCLOUDIUM_HOST_MACHINE;
+  if (raw === undefined) {
+    return true;
+  }
+  const normalized = raw.trim().toLowerCase();
+  if (normalized === "") {
+    return true;
+  }
+  return !["off", "false", "0", "no", "disabled"].includes(normalized);
+}
+
+/**
+ * readDefaultGatewayIp : parse /proc/net/route (Linux) pour retrouver l'IP de
+ * la passerelle par défaut (colonne Gateway de la ligne de destination 00000000).
+ * Le fichier stocke les adresses en hexadécimal little-endian, donc 010014AC
+ * devient 172.20.0.1. Retourne null si le fichier est absent/illisible ou si
+ * aucune route par défaut n'est déclarée — le conteneur tourne alors hors Docker
+ * bridge et l'opérateur doit renseigner ZCLOUDIUM_HOST_SSH_HOST explicitement.
+ */
+export function readDefaultGatewayIp(): string | null {
+  // Lecture synchrone tolérée : /proc/net/route est un pseudo-fichier kernel,
+  // l'I/O est immédiate et ne bloque jamais sur un disk I/O réel.
+  let contents: string;
+  try {
+    contents = readFileSync("/proc/net/route", "utf8");
+  } catch {
+    return null;
+  }
+
+  const lines = contents.split("\n");
+  // Ligne d'en-tête "Iface\tDestination\tGateway\t..." : à ignorer.
+  for (let i = 1; i < lines.length; i += 1) {
+    const line = lines[i]?.trim();
+    if (!line) {
+      continue;
+    }
+    const fields = line.split(/\s+/);
+    if (fields.length < 3) {
+      continue;
+    }
+    const destination = fields[1];
+    const gateway = fields[2];
+    if (destination !== "00000000" || !gateway || gateway === "00000000") {
+      continue;
+    }
+    if (gateway.length !== 8) {
+      continue;
+    }
+    // Little-endian : les octets arrivent par paquets de 2 hex dans l'ordre inverse
+    // de l'adresse IP. 010014AC → AC.14.00.01 → 172.20.0.1.
+    const a = parseInt(gateway.slice(6, 8), 16);
+    const b = parseInt(gateway.slice(4, 6), 16);
+    const c = parseInt(gateway.slice(2, 4), 16);
+    const d = parseInt(gateway.slice(0, 2), 16);
+    if ([a, b, c, d].some((part) => Number.isNaN(part))) {
+      return null;
+    }
+    return `${a}.${b}.${c}.${d}`;
+  }
+  return null;
+}
+
+function getHostMachineDir(): string {
+  return join(getZCodeDataRootDir(), HOST_MACHINE_DIR_RELATIVE);
+}
+
+function getHostMachinePrivateKeyPathInternal(): string {
+  return join(getHostMachineDir(), HOST_MACHINE_PRIVATE_KEY_NAME);
+}
+
+function getHostMachinePublicKeyPath(): string {
+  return join(getHostMachineDir(), HOST_MACHINE_PUBLIC_KEY_NAME);
+}
+
+/**
+ * Convertit une KeyObject publique ed25519 au format OpenSSH texte
+ * (ssh-ed25519 AAAA... commentaire). Le format est :
+ *   uint32_BE(len("ssh-ed25519")) + "ssh-ed25519" + uint32_BE(len(raw)) + raw(32)
+ * puis base64. L'export SPKI/DER contient la raw key dans ses 32 derniers octets.
+ */
+function formatOpenSshEd25519PublicKey(publicKey: KeyObject): string {
+  const der = publicKey.export({ type: "spki", format: "der" }) as Buffer;
+  // Ed25519 SPKI DER = 12 octets d'en-tête ASN.1 + 32 octets de clé brute.
+  const keyTag = Buffer.from("ssh-ed25519", "ascii");
+  const rawKey = der.subarray(der.length - 32);
+  const blob = Buffer.alloc(4 + keyTag.length + 4 + rawKey.length);
+  let offset = 0;
+  blob.writeUInt32BE(keyTag.length, offset);
+  offset += 4;
+  keyTag.copy(blob, offset);
+  offset += keyTag.length;
+  blob.writeUInt32BE(rawKey.length, offset);
+  offset += 4;
+  rawKey.copy(blob, offset);
+  return `ssh-ed25519 ${blob.toString("base64")} ${HOST_MACHINE_KEY_COMMENT}`;
+}
+
+/**
+ * ensureHostMachineKeypair : génère UNE FOIS un couple ed25519 et le persiste
+ * dans {getZCodeDataRootDir()}/ssh/host-machine/. Le dossier est 0700, la clé
+ * privée 0600, la publique 0644 — même contrat qu'un ~/.ssh créé à la main.
+ * Réutilise la clé existante si présente : la clé publique affichée dans le
+ * wizard reste stable d'un redémarrage à l'autre, sinon l'opérateur devrait
+ * re-ajouter authorized_keys après chaque restart du conteneur.
+ */
+export async function ensureHostMachineKeypair(): Promise<{
+  privateKeyPath: string;
+  publicKey: string;
+}> {
+  const dir = getHostMachineDir();
+  const privateKeyPath = getHostMachinePrivateKeyPathInternal();
+  const publicKeyPath = getHostMachinePublicKeyPath();
+
+  await mkdir(dir, { recursive: true, mode: 0o700 });
+
+  let privateKeyExists = false;
+  try {
+    const st = await statFn(privateKeyPath);
+    privateKeyExists = st.isFile();
+  } catch {
+    privateKeyExists = false;
+  }
+
+  if (privateKeyExists) {
+    // Réemploi : on s'assure que les permissions n'ont pas dérivé (montage volume
+    // typiquement), sans toucher au contenu — une réécriture effacerait le lien
+    // authorized_keys déjà installé côté hôte.
+    await chmod(privateKeyPath, 0o600).catch(() => undefined);
+    let cachedPublic: string | null = null;
+    try {
+      cachedPublic = (await readFile(publicKeyPath, "utf8")).trim();
+    } catch {
+      cachedPublic = null;
+    }
+    if (cachedPublic) {
+      return { privateKeyPath, publicKey: cachedPublic };
+    }
+    // Clé publique manquante : on la régénère à partir de la privée stockée
+    // plutôt que de forcer une nouvelle génération (ce qui casserait le lien
+    // authorized_keys de l'hôte). createPublicKey(KeyObject) suffit pour
+    // dériver la publique depuis un PEM privé ed25519.
+    const privateKeyPem = await readFile(privateKeyPath);
+    const privateKeyLoaded = createPrivateKey(privateKeyPem);
+    const publicKey = formatOpenSshEd25519PublicKey(createPublicKey(privateKeyLoaded));
+    await writeFile(publicKeyPath, `${publicKey}\n`, { mode: 0o644 });
+    return { privateKeyPath, publicKey };
+  }
+
+  const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+  const publicOpenSsh = formatOpenSshEd25519PublicKey(publicKey);
+  // OpenSSH private format, pas PKCS#8 : le ssh2 embarqué refuse le PKCS#8
+  // ed25519 ("Unsupported key format", vérifié en bout-en-bout contre la cible).
+  const privateOpenSsh = toOpenSshPrivatePem(privateKey, publicKey, HOST_MACHINE_KEY_COMMENT);
+
+  await writeFile(privateKeyPath, privateOpenSsh, { mode: 0o600 });
+  await writeFile(publicKeyPath, `${publicOpenSsh}\n`, { mode: 0o644 });
+  // Re-force 0700 sur le dossier après écriture : mkdir a posé le mode à la création
+  // mais ne le réapplique pas si le dossier existait déjà (umask du runtime).
+  await chmod(dir, 0o700).catch(() => undefined);
+  await chmod(privateKeyPath, 0o600).catch(() => undefined);
+  await chmod(publicKeyPath, 0o644).catch(() => undefined);
+
+  return { privateKeyPath, publicKey: publicOpenSsh };
+}
+
+/**
+ * zcloudium: sérialise une clé ed25519 au format OpenSSH privé non chiffré
+ * ("openssh-key-v1"). node:crypto n'exporte pas ce format, et le ssh2 embarqué
+ * refuse le PKCS#8 pour ed25519 ("Unsupported key format", vérifié en bout-en-bout).
+ * Wire format documenté : magic + cipher/kdf "none" + 1 clé + section privée
+ * (checkint x2, type, pub, priv = seed 32 o + pub 32 o, comment, padding 1..n).
+ */
+function toOpenSshPrivatePem(
+  privateKey: KeyObject,
+  publicKey: KeyObject,
+  comment: string,
+): string {
+  const lenPrefixed = (buf: Buffer): Buffer => {
+    const head = Buffer.alloc(4);
+    head.writeUInt32BE(buf.length, 0);
+    return Buffer.concat([head, buf]);
+  };
+
+  const keyType = Buffer.from("ssh-ed25519");
+  const publicRaw = publicKey.export({ format: "der", type: "spki" }) as Buffer;
+  const publicRaw32 = publicRaw.subarray(publicRaw.length - 32);
+  const privateDer = privateKey.export({ format: "der", type: "pkcs8" }) as Buffer;
+  const privateSeed = privateDer.subarray(privateDer.length - 32);
+
+  const check = Buffer.from("7a9f31c2", "hex");
+  const pubBlob = Buffer.concat([lenPrefixed(keyType), lenPrefixed(publicRaw32)]);
+  const privSection = Buffer.concat([
+    check,
+    check,
+    lenPrefixed(keyType),
+    lenPrefixed(publicRaw32),
+    lenPrefixed(privateSeed),
+    lenPrefixed(Buffer.from(comment, "utf8")),
+  ]);
+  const padLength = 8 - (privSection.length % 8);
+  const padding = Buffer.alloc(padLength > 0 ? padLength : 0);
+  padding.forEach((_, i) => {
+    padding[i] = i + 1;
+  });
+  const paddedPriv = Buffer.concat([privSection, padding]);
+
+  // AUTH_MAGIC = "openssh-key-v1" + NUL terminal (sizeof du C string), et le
+  // nombre de clés est un uint32 BRUT (pas un string length-préfixé).
+  const head = Buffer.concat([
+    Buffer.from("openssh-key-v1\0", "utf8"),
+    lenPrefixed(Buffer.from("none")),
+    lenPrefixed(Buffer.from("none")),
+    lenPrefixed(Buffer.alloc(0)),
+    Buffer.from([0, 0, 0, 1]),
+    lenPrefixed(pubBlob),
+    lenPrefixed(paddedPriv),
+  ]);
+
+  const b64 = head.toString("base64");
+  const wrapped = b64.match(/.{1,70}/g) ?? [b64];
+  return [
+    "-----BEGIN OPENSSH PRIVATE KEY-----",
+    ...wrapped,
+    "-----END OPENSSH PRIVATE KEY-----",
+    "",
+  ].join("\n");
+}
+
+export function getHostMachinePrivateKeyPath(): string {
+  return getHostMachinePrivateKeyPathInternal();
+}
+
+/**
+ * resolveHostMachineHost : ordre de résolution —
+ *   1. ZCLOUDIUM_HOST_SSH_HOST (override explicite, cas où la gateway n'est
+ *      pas joignable depuis le conteneur, ex. réseau host) ;
+ *   2. readDefaultGatewayIp() (cas Docker bridge standard) ;
+ *   3. undefined — le wizard affichera un champ pré-rempli vide.
+ */
+function resolveHostMachineHost(env: NodeJS.ProcessEnv = process.env): string | undefined {
+  const override = env.ZCLOUDIUM_HOST_SSH_HOST?.trim();
+  if (override) {
+    return override;
+  }
+  return readDefaultGatewayIp() ?? undefined;
+}
+
+function resolveHostMachineUsername(env: NodeJS.ProcessEnv = process.env): string {
+  return env.ZCLOUDIUM_HOST_SSH_USER?.trim() ?? "";
+}
+
+/**
+ * registerHostMachineRoutes : GET /api/host-machine. La gateway Hono exige déjà
+ * la session pour /api/* (middleware token du createHttpServer principal), donc
+ * aucune authentification supplémentaire ici — la réponse ne contient que des
+ * métadonnées non secrètes (host, port, username, publicKey). La clé privée
+ * n'est JAMAIS renvoyée ; elle reste cantonnée au processus serveur.
+ */
+export function registerHostMachineRoutes(app: Hono): void {
+  app.get("/api/host-machine", async (c) => {
+    if (!isHostMachineEnabled()) {
+      return c.json({ enabled: false });
+    }
+    const host = resolveHostMachineHost();
+    const username = resolveHostMachineUsername();
+    let keypair: { privateKeyPath: string; publicKey: string };
+    try {
+      keypair = await ensureHostMachineKeypair();
+    } catch (error) {
+      // Échec clef : ne pas tomber en 500 brut, exposer un enabled=false pour
+      // que le wizard masque proprement la carte au lieu de bloquer l'UX.
+      // Sanitize : error.message contient typiquement le chemin absolu du
+      // fichier fautif (EACCES … '/data/ssh/host-machine/id_ed25519'), ce qui
+      // fuiterait le layout filesystem dans les logs. On logue uniquement le
+      // code d'erreur stable + la classe d'exception.
+      const code =
+        error && typeof error === "object" && "code" in error
+          ? String((error as { code?: unknown }).code)
+          : undefined;
+      const name = error instanceof Error ? error.name : undefined;
+      console.warn(
+        "[zcode-server:host-machine] ensureHostMachineKeypair failed",
+        { name, code },
+      );
+      return c.json({ enabled: false });
+    }
+    // zcloudium: privateKeyPath volontairement ABSENT de la réponse — la spec
+    // sécurité interdit de révéler quoi que ce soit du chemin de la clé privée
+    // (ni son contenu, ni son emplacement). Le client n'en a pas besoin : la
+    // substitution côté POST /api/connect-remote appelle le même getter interne
+    // (getHostMachinePrivateKeyPath) directement côté serveur.
+    return c.json({
+      enabled: true,
+      host,
+      port: 22,
+      username,
+      publicKey: keypair.publicKey,
+    });
+  });
+}
