diff --git a/packages/ui/src/lib/chatAttachments.ts b/packages/ui/src/lib/chatAttachments.ts
index c1612a7..ccaa6a1 100644
--- a/packages/ui/src/lib/chatAttachments.ts
+++ b/packages/ui/src/lib/chatAttachments.ts
@@ -58,6 +58,29 @@ export interface ChatComposerAttachment {
 
 const PDF_MIME_TYPE = "application/pdf";
 
+/**
+ * zcloudium: en web, un fichier qui n'a ni chemin local ni contenu inlinable
+ * (image/vidéo/PDF/texte) échouerait au moment de l'envoi. Ceux-là sont
+ * déposés au préalable dans l'espace de l'agent via /api/stage-attachment,
+ * qui rend un vrai chemin — les autres suivent le flux inline existant.
+ */
+export function isWebStageableAttachment(attachment: {
+  filename: string;
+  mimeType: string;
+  file?: File;
+}): boolean {
+  const mimeType = normalizeComposerMimeType(
+    attachment.mimeType || inferAttachmentMimeType(attachment.filename),
+  );
+  if (mimeType.startsWith("image/") || mimeType.startsWith("video/") || mimeType === PDF_MIME_TYPE) {
+    return false;
+  }
+  if (attachment.file && isTextLikeAttachment(attachment)) {
+    return false;
+  }
+  return true;
+}
+
 function normalizeComposerMimeType(mimeType: string): string {
   const normalized = mimeType.split(";", 1)[0]?.trim().toLowerCase() ?? "";
   return normalized === PDF_MIME_TYPE ? PDF_MIME_TYPE : mimeType;
