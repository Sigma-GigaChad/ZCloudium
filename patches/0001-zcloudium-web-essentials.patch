@@ -0,0 +1,122 @@
+import { ProxyChannel, type IChannel } from "@zcode/rpc";
+import {
+  ServiceCollection,
+  IBotsService,
+  IBroadcastService,
+  IClientConfigService,
+  IClientScenesService,
+  ICodingPlanSubscriptionService,
+  ICommandsService,
+  IConversationShareService,
+  ICredentialService,
+  ICuaPermissionService,
+  IFeedbackService,
+  IFileService,
+  IFileWatcherService,
+  IGitCheckpointService,
+  IGitService,
+  IHooksService,
+  IMcpSyncService,
+  IMediaPreviewService,
+  IMemoryService,
+  IModelSelectionService,
+  IOAuthService,
+  IOffPeakTaskService,
+  IOnboardingRecordService,
+  IPluginManagementService,
+  IPluginsService,
+  IPluginSyncService,
+  IPromptAttachmentTransferService,
+  IProviderSettingsService,
+  ISkillsService,
+  ISkillSyncService,
+  ISettingService,
+  ISettingsSyncService,
+  ISubagentsService,
+  ISystemService,
+  ITerminalService,
+  IUsageStatsService,
+  IWindowControllerService,
+  IZCodeAgentService,
+  IZCodeSessionService,
+  IZCodeTaskService,
+  type ServiceDescriptor,
+} from "@zcode/services";
+import type { RemoteConnection } from "./remote/index.js";
+
+/**
+ * Bridge the full remote service set onto a local WebSocket.
+ *
+ * `/ws/remote/:id` used to expose only four services, which is why web mode
+ * could not open a remote workspace: the renderer needs the same accessor the
+ * desktop one has. This mirrors the channel list of `RemoteServiceAccess`
+ * (packages/client/src/remoteServiceAccess.ts) one for one, registering
+ * service-shaped proxies over the connection's channel client — the same
+ * objects upstream's accessor builds, so `exposeOnChannelServer` can wrap them
+ * exactly like it wraps local services.
+ *
+ * `IProviderProvisioningTargetService` is deliberately absent, like on the
+ * desktop renderer boundary: provisioning carries cross-Environment
+ * credentials and is a trusted-host-only capability (see the override in
+ * setupChannelServer).
+ */
+export function remoteServiceCollection(connection: RemoteConnection): ServiceCollection {
+  const descriptors: ServiceDescriptor<unknown>[] = [
+    IFileService,
+    IMediaPreviewService,
+    IGitService,
+    IGitCheckpointService,
+    ISystemService,
+    ITerminalService,
+    ISettingService,
+    IOnboardingRecordService,
+    ICredentialService,
+    IBroadcastService,
+    IZCodeTaskService,
+    IWindowControllerService,
+    IZCodeAgentService,
+    IZCodeSessionService,
+    ICuaPermissionService,
+    IConversationShareService,
+    IBotsService,
+    IFileWatcherService,
+    IOAuthService,
+    IProviderSettingsService,
+    IModelSelectionService,
+    IUsageStatsService,
+    ICodingPlanSubscriptionService,
+    IClientConfigService,
+    IClientScenesService,
+    IOffPeakTaskService,
+    ISkillsService,
+    ISkillSyncService,
+    IMcpSyncService,
+    IPluginSyncService,
+    IPluginsService,
+    IPluginManagementService,
+    ISubagentsService,
+    ICommandsService,
+    IHooksService,
+    IMemoryService,
+    ISettingsSyncService,
+    IFeedbackService,
+    IPromptAttachmentTransferService,
+  ];
+
+  const collection = new ServiceCollection();
+  for (const descriptor of descriptors) {
+    // Register service-shaped proxies, the same shape exposeOnChannelServer
+    // expects (it wraps every value in ProxyChannel.fromService, which
+    // dispatches by method name on the object): a raw {call, listen} channel
+    // adapter would die on the first RPC with "Method not found". toService
+    // proxies round-trip through fromService: method access becomes a call,
+    // on* access a buffered listen.
+    collection.register(
+      descriptor,
+      ProxyChannel.toService<Record<string, unknown>>(
+        connection.client.getChannel<IChannel>(descriptor.channelName),
+      ),
+    );
+  }
+  return collection;
+}
