+/**
+ * Tests for the server-side staging of prompt attachments in a web remote
+ * workspace.
+ *
+ * The browser composer stages the bytes on THIS machine (POST
+ * /api/stage-attachment returns a real server path), then asks
+ * IPromptAttachmentTransferService.stage to make them readable by the remote
+ * agent. Over /ws/remote/:id that call must be served by a server-side
+ * service streaming the staged bytes over the session's SSH backend — the
+ * remote runtime's local stub returns staged:false and blocks the send.
+ */
+import { PassThrough } from "node:stream";
+import { mkdtemp, rm, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Event, IDisposable } from "@zcode/rpc";
+import { IFileService, IPromptAttachmentTransferService } from "@zcode/services";
+import type { PromptAttachmentStageParams } from "@zcode/services";
+import type { RemoteUploadOptions } from "@zcode/server/remote";
+import { setDataBaseDir } from "@zcode/services/node";
+import {
+  STAGE_MAX_BYTES,
+  stageAttachmentBytes,
+  stagedAttachmentDir,
+} from "../src/attachmentStage.js";
+import { remoteServiceCollection } from "../src/remoteBridge.js";
+import { RemoteSessionRegistry } from "../src/remoteSessionRegistry.js";
+import type { RemoteConnection } from "../src/remote/connect.js";
+import { createRemotePromptAttachmentTransferService, REMOTE_ATTACHMENT_TRANSFER_DISPOSE } from "../src/remoteAttachmentTransfer.js";
+
+function createClosedStream(stdoutText = "") {
+  const stdin = new PassThrough();
+  const stdout = new PassThrough();
+  const stderr = new PassThrough();
+  const onClose: Event<number> = (listener: (code: number) => void): IDisposable => {
+    queueMicrotask(() => {
+      if (stdoutText) stdout.write(stdoutText);
+      stdout.end();
+      listener(0);
+    });
+    return { dispose() {} };
+  };
+  return { stdin, stdout, stderr, onClose };
+}
+
+interface FakeBackendOptions {
+  failExec?: boolean;
+  failUpload?: boolean;
+}
+
+function createFakeBackend(options: FakeBackendOptions = {}) {
+  const commands: string[] = [];
+  const uploads: Array<{ localPath: string; remotePath: string; options?: RemoteUploadOptions }> =
+    [];
+  const exec = vi.fn(async (command: string) => {
+    if (options.failExec) {
+      throw new Error("SSH backend 已释放，无法重新建立连接");
+    }
+    commands.push(command);
+    return createClosedStream(command === 'printf %s "$HOME"' ? "/home/tester" : "");
+  });
+  const upload = vi.fn(
+    async (localPath: string, remotePath: string, uploadOptions?: RemoteUploadOptions) => {
+      if (options.failUpload) {
+        throw new Error("SSH backend 已释放，无法重新建立连接");
+      }
+      uploadOptions?.onProgress?.({ uploadedBytes: 20, totalBytes: 100 });
+      uploadOptions?.onProgress?.({ uploadedBytes: 100, totalBytes: 100 });
+      uploads.push({ localPath, remotePath, options: uploadOptions });
+    },
+  );
+  return { exec, upload, commands, uploads };
+}
+
+function stageParams(
+  localPath: string,
+  sizeBytes?: number,
+  operationId = "attachment-1",
+): PromptAttachmentStageParams {
+  return {
+    operationId,
+    sessionId: "session-1",
+    workspacePath: "/workspace",
+    workspaceIdentity: "remote:ssh:example",
+    remoteSessionId: "remote-session-1",
+    localPath,
+    fileName: "report.zip",
+    mime: "application/zip",
+    ...(sizeBytes === undefined ? {} : { sizeBytes }),
+  };
+}
+
+let dataBaseDir: string;
+
+beforeEach(async () => {
+  // The service confines sources to the server staging root; isolate the data
+  // root so the test never touches the real ~/.zcodium.
+  dataBaseDir = await mkdtemp(join(tmpdir(), "zcode-remote-attachment-test-"));
+  setDataBaseDir(dataBaseDir);
+});
+
+afterEach(async () => {
+  setDataBaseDir(null);
+  await rm(dataBaseDir, { recursive: true, force: true });
+});
+
+describe("server remote prompt attachment transfer service", () => {
+  it("streams the staged bytes over the backend and returns staged:true with the remote path", async () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+    const phases: string[] = [];
+    const uploadedBytes: number[] = [];
+    const subscription = service.onDynamicProgress("attachment-1")((event) => {
+      phases.push(event.phase);
+      uploadedBytes.push(event.uploadedBytes);
+    });
+
+    const result = await service.stage(stageParams(staged.path, staged.sizeBytes));
+    subscription.dispose();
+
+    expect(result.staged).toBe(true);
+    expect(result.bytes).toBe(100);
+    // Desktop parity: the whole `${workspace}\0${remoteSessionId}\0${operationId}`
+    // trace is sanitized into one segment, as remotePromptAttachments.ts does.
+    expect(result.ref).toMatch(
+      /^\/home\/tester\/\.zcode\/tmp\/prompt-attachments\/remote-ssh-example-remote-session-1-attachment-1\/[0-9a-f-]+\/01-report\.zip$/,
+    );
+    expect(backend.uploads).toHaveLength(1);
+    expect(backend.uploads[0]?.localPath).toBe(staged.path);
+    expect(backend.uploads[0]?.remotePath).toBe(result.ref);
+    expect(phases).toEqual(["uploading", "uploading", "committing", "complete"]);
+    expect(uploadedBytes).toEqual([20, 100, 100, 100]);
+    // Private staging layout mirrored from the desktop materializer: 0700 dirs, 0600 file.
+    expect(
+      backend.commands.some(
+        (command) => command.includes(`chmod 700`) && command.includes("/home/tester/.zcode"),
+      ),
+    ).toBe(true);
+    expect(
+      backend.commands.some((command) => command.includes(`chmod 600 '${result.ref}'`)),
+    ).toBe(true);
+  });
+
+  it("adopt keeps the staged file; cleanup before adopt removes it", async () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+
+    await service.stage(stageParams(staged.path, staged.sizeBytes, "attachment-adopt"));
+    await service.adopt("attachment-adopt");
+    await service.cleanup("attachment-adopt");
+    const afterAdopt = backend.commands.filter((command) => command.startsWith("rm -f "));
+    expect(afterAdopt).toEqual([]);
+
+    await service.stage(stageParams(staged.path, staged.sizeBytes, "attachment-cleanup"));
+    await service.cleanup("attachment-cleanup");
+    const afterCleanup = backend.commands.filter((command) => command.startsWith("rm -f "));
+    expect(afterCleanup).toHaveLength(1);
+    expect(afterCleanup[0]).toContain("prompt-attachments");
+  });
+
+  it("cancel aborts an in-flight upload and reports canceled", async () => {
+    const backend = createFakeBackend();
+    backend.upload.mockImplementation(
+      async (_localPath: string, _remotePath: string, uploadOptions?: RemoteUploadOptions) =>
+        new Promise<void>((_resolve, reject) => {
+          uploadOptions?.signal?.addEventListener("abort", () => {
+            const error = new Error("canceled");
+            error.name = "AbortError";
+            reject(error);
+          });
+        }),
+    );
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+    const phases: string[] = [];
+    service.onDynamicProgress("attachment-cancel")((event) => phases.push(event.phase));
+
+    const staging = service.stage(stageParams(staged.path, staged.sizeBytes, "attachment-cancel"));
+    await vi.waitFor(() => expect(backend.upload).toHaveBeenCalledTimes(1));
+    await service.cancel("attachment-cancel");
+
+    await expect(staging).rejects.toThrow("远端附件上传失败：report.zip");
+    expect(phases).toContain("canceled");
+    expect(backend.upload.mock.calls[0]?.[2]?.signal?.aborted).toBe(true);
+  });
+
+  it("rejects a source outside the server staging root without calling the backend", async () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const outsidePath = join(dataBaseDir, "outside.txt");
+    await writeFile(outsidePath, "not staged");
+
+    await expect(
+      service.stage(stageParams(outsidePath, 9)),
+    ).rejects.toThrow(/not a server-staged file/);
+    expect(backend.upload).not.toHaveBeenCalled();
+  });
+
+  it("enforces the same 20 MiB cap as the staging route", async () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(4));
+    const routeError = await stageAttachmentBytes(
+      "big.bin",
+      new Uint8Array(STAGE_MAX_BYTES + 1),
+    ).catch((error: unknown) => error as Error);
+    expect(routeError.message).toContain("20 MiB");
+
+    // Declared size over the cap: rejected before any stat/upload.
+    await expect(
+      service.stage(stageParams(staged.path, STAGE_MAX_BYTES + 1)),
+    ).rejects.toThrow(routeError.message);
+    expect(backend.upload).not.toHaveBeenCalled();
+
+    // Actual file over the cap (client understated sizeBytes): rejected too.
+    const oversizedPath = join(stagedAttachmentDir(), "oversized.bin");
+    await writeFile(oversizedPath, Buffer.alloc(STAGE_MAX_BYTES + 1));
+    await expect(service.stage(stageParams(oversizedPath, 1))).rejects.toThrow(routeError.message);
+    expect(backend.upload).not.toHaveBeenCalled();
+    expect((await stat(oversizedPath)).size).toBeGreaterThan(STAGE_MAX_BYTES);
+  });
+
+  it("fails explicitly when the SSH session is gone instead of returning unstaged", async () => {
+    const backend = createFakeBackend({ failUpload: true });
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+
+    const error = await service
+      .stage(stageParams(staged.path, staged.sizeBytes))
+      .catch((cause: unknown) => cause as Error & { cause?: unknown });
+
+    expect(error).toBeInstanceOf(Error);
+    expect(error.message).toBe("远端附件上传失败：report.zip");
+    expect(error.cause).toBeInstanceOf(Error);
+    expect((error.cause as Error).message).toContain("SSH backend 已释放");
+  });
+
+  it("fails explicitly for a disposed session", async () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+
+    // The registry-only hook is symbol-keyed: no string method reaches the RPC surface.
+    expect((service as unknown as Record<string, unknown>).dispose).toBeUndefined();
+    service[REMOTE_ATTACHMENT_TRANSFER_DISPOSE]();
+
+    await expect(service.stage(stageParams(staged.path, staged.sizeBytes))).rejects.toThrow(
+      "远端附件暂存会话已断开",
+    );
+    expect(backend.upload).not.toHaveBeenCalled();
+  });
+});
+
+describe("remote bridge attachment wiring", () => {
+  it("serves the server-side transfer service for the descriptor when provided", () => {
+    const backend = createFakeBackend();
+    const service = createRemotePromptAttachmentTransferService(backend);
+    const connection = {
+      client: {
+        getChannel: () => ({ call: async () => undefined, listen: () => undefined }),
+      },
+    } as unknown as RemoteConnection;
+
+    const collection = remoteServiceCollection(connection, {
+      promptAttachmentTransferService: service,
+    });
+    expect(collection.get(IPromptAttachmentTransferService)).toBe(service);
+    // Every other channel keeps its proxy.
+    expect(collection.get(IFileService)).toBeDefined();
+    expect(collection.get(IFileService)).not.toBe(service);
+
+    // Without the option (e.g. the local /ws path), the descriptor stays a proxy.
+    const proxyOnly = remoteServiceCollection(connection);
+    expect(proxyOnly.get(IPromptAttachmentTransferService)).not.toBe(service);
+  });
+
+  it("binds the staging service to the session and disposes it on remote close", async () => {
+    const registry = new RemoteSessionRegistry();
+    const backend = createFakeBackend();
+    const dispose = vi.fn();
+    const connection = {
+      services: {},
+      client: {},
+      dispose,
+      disposeAndWait: async () => undefined,
+    } as unknown as RemoteConnection;
+    let closeListener: ((code: number) => void) | undefined;
+
+    const { id } = await registry.connect(
+      { kind: "server", url: "https://example.test" },
+      {},
+      async (onDidRemoteClose) => {
+        closeListener = onDidRemoteClose;
+        return { connection, backend };
+      },
+    );
+    const session = registry.getSession(id);
+    expect(session?.promptAttachmentTransferService).toBeDefined();
+    const staged = await stageAttachmentBytes("report.zip", new Uint8Array(100));
+    const result = await session!.promptAttachmentTransferService.stage(
+      stageParams(staged.path, staged.sizeBytes),
+    );
+    expect(result.staged).toBe(true);
+
+    closeListener?.(1);
+
+    expect(dispose).toHaveBeenCalledTimes(1);
+    // The dead channel fails closed: an explicit error, never staged:false.
+    await expect(
+      session!.promptAttachmentTransferService.stage(stageParams(staged.path, staged.sizeBytes)),
+    ).rejects.toThrow("远端附件暂存会话已断开");
+  });
+});
