index 00000000..a95ec7a3
--- /dev/null
+++ b/packages/server/src/remoteAttachmentTransfer.ts
@@ -0,0 +1,434 @@
+import { randomUUID } from "node:crypto";
+import { stat } from "node:fs/promises";
+import { join, resolve, sep } from "node:path";
+import { Emitter } from "@zcode/rpc";
+import type {
+  IPromptAttachmentTransferService,
+  PromptAttachmentStageParams,
+  PromptAttachmentStageResult,
+  PromptAttachmentTransferProgress,
+} from "@zcode/services";
+import { getZCodeDataRootDir } from "@zcode/services/node";
+import { STAGE_MAX_BYTES } from "./attachmentStage.js";
+import type { IRemoteBackend, RemoteUploadProgress } from "./remote/backend.js";
+import { quotePosixPathArg } from "./remote/posixShell.js";
+
+/**
+ * Server-side staging of prompt attachments for a remote web workspace.
+ *
+ * The web composer uploads the bytes to THIS machine first
+ * (POST /api/stage-attachment returns a real server path), then asks
+ * IPromptAttachmentTransferService.stage to hand the remote agent a path it can
+ * read. Over /ws/remote/:id that call must be served here — the remote
+ * runtime's own local stub returns staged:false, and the remote agent cannot
+ * read a path that only exists on the server. This service streams the staged
+ * bytes over the session's SSH/WSL/Docker backend, reusing the desktop host's
+ * remote layout (`~/.zcode/tmp/prompt-attachments`, dirs 0700, files 0600) so
+ * both hosts materialize the same paths, and fails explicitly when the session
+ * (backend) is gone instead of silently reporting "not staged".
+ */
+
+const REMOTE_PROMPT_ATTACHMENT_ROOT = "~/.zcode/tmp/prompt-attachments";
+const REMOTE_PROMPT_ATTACHMENT_RELATIVE_ROOT = ".zcode/tmp/prompt-attachments";
+
+/**
+ * Registry-only lifecycle hook. Symbol-keyed because
+ * `ProxyChannel.fromService` dispatches string method names: a `dispose()`
+ * method would be callable by any browser attached to the session, while the
+ * transport owner (the session registry) must be the only caller.
+ */
+export const REMOTE_ATTACHMENT_TRANSFER_DISPOSE = Symbol("remoteAttachmentTransferDispose");
+
+export interface RemotePromptAttachmentTransferService extends IPromptAttachmentTransferService {
+  /**
+   * Called by the session registry when the SSH connection dies: abort
+   * in-flight uploads and fail closed on late stage calls.
+   */
+  [REMOTE_ATTACHMENT_TRANSFER_DISPOSE](): void;
+}
+
+interface TransferRecord {
+  controller: AbortController;
+  ref?: string;
+  bytes: number;
+  adopted: boolean;
+}
+
+const SESSION_GONE_ERROR = "远端附件暂存会话已断开";
+
+function isAbortError(error: unknown): boolean {
+  return error instanceof Error && error.name === "AbortError";
+}
+
+/** Same text as the staging route's cap rejection, against the same constant. */
+function formatStageLimitError(): string {
+  return `Attachment exceeds the ${Math.floor(STAGE_MAX_BYTES / 1024 / 1024)} MiB web limit`;
+}
+
+/** The staged bytes must live under the server's own staging root. */
+function stagedAttachmentRootDir(): string {
+  return resolve(join(getZCodeDataRootDir(), "tmp", "paste-attachments"));
+}
+
+function isInsideStagedRoot(localPath: string): boolean {
+  const root = stagedAttachmentRootDir();
+  const resolved = resolve(localPath);
+  return resolved === root || resolved.startsWith(`${root}${sep}`);
+}
+
+export function createRemotePromptAttachmentTransferService(
+  backend: Pick<IRemoteBackend, "exec" | "upload">,
+  options: { onJanitorError?: (error: unknown) => void } = {},
+): RemotePromptAttachmentTransferService {
+  const records = new Map<string, TransferRecord>();
+  const emitters = new Map<string, Emitter<PromptAttachmentTransferProgress>>();
+  let disposed = false;
+
+  // Desktop parity: a host rebuild reclaims staging leftovers nobody adopted.
+  void cleanupStaleRemotePromptAttachments(backend).catch((error) => {
+    options.onJanitorError?.(error);
+  });
+
+  const getEmitter = (operationId: string) => {
+    const existing = emitters.get(operationId);
+    if (existing) return existing;
+    const emitter = new Emitter<PromptAttachmentTransferProgress>({
+      onDidRemoveLastListener: () => {
+        emitters.delete(operationId);
+        emitter.dispose();
+      },
+    });
+    emitters.set(operationId, emitter);
+    return emitter;
+  };
+
+  const releaseRecord = async (operationId: string, includeAdopted: boolean) => {
+    const record = records.get(operationId);
+    if (!record) return;
+    record.controller.abort();
+    if (record.ref && (includeAdopted || !record.adopted)) {
+      await cleanupRemotePromptAttachment(backend, record.ref).catch(() => {});
+    }
+    records.delete(operationId);
+  };
+
+  return {
+    async stage(params: PromptAttachmentStageParams): Promise<PromptAttachmentStageResult> {
+      if (disposed) {
+        throw new Error(SESSION_GONE_ERROR);
+      }
+      await releaseRecord(params.operationId, false);
+      const declaredBytes = Math.max(0, params.sizeBytes ?? 0);
+      if (declaredBytes > STAGE_MAX_BYTES) {
+        throw new Error(formatStageLimitError());
+      }
+      if (!isInsideStagedRoot(params.localPath)) {
+        throw new Error("Attachment source is not a server-staged file");
+      }
+      // The staged file on disk is the source of truth: a lying sizeBytes must
+      // not push an oversized upload past the cap the route enforces.
+      const fileStat = await stat(params.localPath).catch(() => undefined);
+      const actualBytes = fileStat?.size ?? 0;
+      if (actualBytes > STAGE_MAX_BYTES) {
+        throw new Error(formatStageLimitError());
+      }
+      const bytes = Math.max(declaredBytes, actualBytes);
+
+      const controller = new AbortController();
+      const record: TransferRecord = { controller, bytes, adopted: false };
+      records.set(params.operationId, record);
+      const emitter = getEmitter(params.operationId);
+      let lastPercent = -1;
+      let lastEmittedAt = 0;
+      let lastUploadedBytes = 0;
+      const workspaceKey = params.workspaceIdentity?.trim() || params.workspacePath;
+      // Same trace composition as the desktop host's eager staging: the remote
+      // directory stays namespaced by workspace/session/operation.
+      const traceId = `${workspaceKey}\u0000${params.remoteSessionId ?? ""}\u0000${params.operationId}`;
+      try {
+        const ref = await uploadRemotePromptAttachment({
+          backend,
+          localPath: params.localPath,
+          fileName: params.fileName,
+          traceId,
+          signal: controller.signal,
+          onProgress(progress) {
+            const totalBytes = Math.max(progress.totalBytes, record.bytes);
+            record.bytes = totalBytes;
+            lastUploadedBytes = Math.max(lastUploadedBytes, progress.uploadedBytes);
+            const percent =
+              totalBytes > 0 ? Math.floor((lastUploadedBytes / totalBytes) * 100) : 0;
+            const now = Date.now();
+            if (percent <= lastPercent && now - lastEmittedAt < 100) return;
+            lastPercent = Math.max(lastPercent, percent);
+            lastEmittedAt = now;
+            emitter.fire({
+              operationId: params.operationId,
+              phase: "uploading",
+              uploadedBytes: lastUploadedBytes,
+              totalBytes,
+            });
+          },
+        });
+        if (records.get(params.operationId) !== record || controller.signal.aborted) {
+          throw Object.assign(new Error("Remote upload canceled"), { name: "AbortError" });
+        }
+        record.ref = ref;
+        emitter.fire({
+          operationId: params.operationId,
+          phase: "committing",
+          uploadedBytes: record.bytes,
+          totalBytes: record.bytes,
+        });
+        emitter.fire({
+          operationId: params.operationId,
+          phase: "complete",
+          uploadedBytes: record.bytes,
+          totalBytes: record.bytes,
+        });
+        return {
+          operationId: params.operationId,
+          ref,
+          bytes: record.bytes,
+          staged: true,
+        };
+      } catch (error) {
+        if (isAbortError(error) || controller.signal.aborted) {
+          emitter.fire({
+            operationId: params.operationId,
+            phase: "canceled",
+            uploadedBytes: 0,
+            totalBytes: record.bytes,
+          });
+        }
+        if (records.get(params.operationId) === record) {
+          records.delete(params.operationId);
+        }
+        throw error;
+      }
+    },
+    async adopt(operationId) {
+      const record = records.get(operationId);
+      if (record?.ref) {
+        record.adopted = true;
+        records.delete(operationId);
+      }
+    },
+    async cancel(operationId) {
+      await releaseRecord(operationId, false);
+    },
+    async cleanup(operationId) {
+      await releaseRecord(operationId, false);
+    },
+    onDynamicProgress: (operationId) => getEmitter(operationId).event,
+    [REMOTE_ATTACHMENT_TRANSFER_DISPOSE]() {
+      if (disposed) return;
+      disposed = true;
+      for (const record of records.values()) {
+        record.controller.abort();
+      }
+      records.clear();
+      for (const emitter of emitters.values()) {
+        emitter.dispose();
+      }
+      emitters.clear();
+    },
+  };
+}
+
+interface UploadRemotePromptAttachmentParams {
+  backend: Pick<IRemoteBackend, "exec" | "upload">;
+  localPath: string;
+  fileName: string;
+  traceId: string;
+  signal: AbortSignal;
+  onProgress?: (progress: RemoteUploadProgress) => void;
+}
+
+/**
+ * Upload one staged attachment to the remote prompt-attachment root.
+ * Mirrors the desktop materializer's single-file path: private dirs, upload,
+ * lock the file down, and reclaim a half-written file on failure.
+ */
+async function uploadRemotePromptAttachment(
+  params: UploadRemotePromptAttachmentParams,
+): Promise<string> {
+  const remoteRoot = await resolveRemotePromptAttachmentRoot(params.backend);
+  const remotePath = buildRemotePromptAttachmentPath({
+    filename: params.fileName,
+    index: 0,
+    root: remoteRoot,
+    traceId: params.traceId,
+  });
+  try {
+    await ensureRemotePromptAttachmentDirectory(params.backend, remotePath, remoteRoot);
+    await params.backend.upload(params.localPath, remotePath, {
+      signal: params.signal,
+      onProgress: params.onProgress,
+    });
+    await lockDownRemotePromptAttachmentFile(params.backend, remotePath);
+  } catch (error) {
+    await cleanupRemotePromptAttachment(params.backend, remotePath).catch(() => {});
+    throw new Error(`远端附件上传失败：${params.fileName}`, { cause: error });
+  }
+  return remotePath;
+}
+
+async function cleanupRemotePromptAttachment(
+  backend: Pick<IRemoteBackend, "exec">,
+  remotePath: string,
+): Promise<void> {
+  const root = await resolveRemotePromptAttachmentRoot(backend);
+  if (!isRemotePromptAttachmentPath(remotePath, root)) return;
+  const remoteDir = remoteDirname(remotePath);
+  await waitForRemoteCommand(
+    backend,
+    `rm -f ${quotePosixPathArg(remotePath)} && rmdir ${quotePosixPathArg(remoteDir)} 2>/dev/null || true`,
+  );
+}
+
+async function cleanupStaleRemotePromptAttachments(
+  backend: Pick<IRemoteBackend, "exec">,
+  olderThanMinutes = 24 * 60,
+): Promise<void> {
+  const root = await resolveRemotePromptAttachmentRoot(backend);
+  await waitForRemoteCommand(
+    backend,
+    `if [ -d ${quotePosixPathArg(root)} ]; then find ${quotePosixPathArg(root)} -type f -mmin +${Math.max(1, Math.floor(olderThanMinutes))} -delete; find ${quotePosixPathArg(root)} -mindepth 1 -depth -type d -empty -delete; fi`,
+  );
+}
+
+function buildRemotePromptAttachmentPath(params: {
+  filename: string;
+  index: number;
+  nonce?: string;
+  root?: string;
+  traceId: string;
+}): string {
+  const traceSegment = sanitizePathSegment(String(params.traceId)).slice(0, 80) || "trace";
+  const nonceSegment = sanitizePathSegment(params.nonce ?? randomUUID()).slice(0, 64);
+  const filename = sanitizePathSegment(basenameFromPathLike(params.filename)) || "attachment";
+  const indexSegment = String(params.index + 1).padStart(2, "0");
+  const root = params.root ?? REMOTE_PROMPT_ATTACHMENT_ROOT;
+  return `${root}/${traceSegment}/${nonceSegment}/${indexSegment}-${filename.slice(0, 160)}`;
+}
+
+async function ensureRemotePromptAttachmentDirectory(
+  backend: Pick<IRemoteBackend, "exec">,
+  remotePath: string,
+  root: string,
+): Promise<void> {
+  const remoteDir = remoteDirname(remotePath);
+  const privateDirs = collectRemotePromptAttachmentPrivateDirs(remoteDir, root);
+  // Staged attachments may contain clipboard or file content: never land in a
+  // shared /tmp; create user-private dirs before the first byte.
+  const command = [
+    `mkdir -p ${quotePosixPathArg(remoteDir)}`,
+    `command chmod 700 ${privateDirs.map((dir) => quotePosixPathArg(dir)).join(" ")}`,
+  ].join(" && ");
+  await waitForRemoteCommand(backend, command);
+}
+
+async function lockDownRemotePromptAttachmentFile(
+  backend: Pick<IRemoteBackend, "exec">,
+  remotePath: string,
+): Promise<void> {
+  await waitForRemoteCommand(backend, `command chmod 600 ${quotePosixPathArg(remotePath)}`);
+}
+
+async function resolveRemotePromptAttachmentRoot(
+  backend: Pick<IRemoteBackend, "exec">,
+): Promise<string> {
+  const homeDir = await readRemoteCommandStdout(backend, 'printf %s "$HOME"');
+  const normalizedHome = homeDir.trim().replace(/\/+$/u, "");
+  if (!normalizedHome.startsWith("/")) {
+    throw new Error("remote HOME is not an absolute path");
+  }
+  return `${normalizedHome}/${REMOTE_PROMPT_ATTACHMENT_RELATIVE_ROOT}`;
+}
+
+async function readRemoteCommandStdout(
+  backend: Pick<IRemoteBackend, "exec">,
+  command: string,
+): Promise<string> {
+  const stream = await backend.exec(command);
+  let stdoutText = "";
+  let stderrText = "";
+  stream.stdout.on("data", (chunk: Buffer | string) => {
+    stdoutText += chunk.toString();
+  });
+  stream.stderr.on("data", (chunk: Buffer | string) => {
+    stderrText += chunk.toString();
+  });
+  await new Promise<void>((resolvePromise, reject) => {
+    stream.onClose((code) => {
+      if (code === 0) {
+        resolvePromise();
+        return;
+      }
+      reject(
+        new Error(
+          `remote command failed with exit code ${code}: ${command}${
+            stderrText ? `: ${stderrText}` : ""
+          }`,
+        ),
+      );
+    });
+  });
+  return stdoutText;
+}
+
+async function waitForRemoteCommand(
+  backend: Pick<IRemoteBackend, "exec">,
+  command: string,
+): Promise<void> {
+  const stream = await backend.exec(command);
+  await new Promise<void>((resolvePromise, reject) => {
+    stream.onClose((code) => {
+      if (code === 0) {
+        resolvePromise();
+        return;
+      }
+      reject(new Error(`remote command failed with exit code ${code}: ${command}`));
+    });
+  });
+}
+
+function isRemotePromptAttachmentPath(path: string, remoteRoot: string): boolean {
+  return isPathInRoot(path, REMOTE_PROMPT_ATTACHMENT_ROOT) || isPathInRoot(path, remoteRoot);
+}
+
+function isPathInRoot(path: string, root: string): boolean {
+  return path === root || path.startsWith(`${root}/`);
+}
+
+function remoteDirname(remotePath: string): string {
+  const slashIndex = remotePath.lastIndexOf("/");
+  return slashIndex > 0 ? remotePath.slice(0, slashIndex) : REMOTE_PROMPT_ATTACHMENT_ROOT;
+}
+
+function collectRemotePromptAttachmentPrivateDirs(remoteDir: string, root: string): string[] {
+  const relativeDir = remoteDir.startsWith(`${root}/`) ? remoteDir.slice(root.length + 1) : "";
+  const segments = relativeDir.split("/").filter(Boolean);
+  const dirs = [root];
+  let current = root;
+  for (const segment of segments) {
+    current = `${current}/${segment}`;
+    dirs.push(current);
+  }
+  return dirs;
+}
+
+function basenameFromPathLike(pathLike: string): string {
+  const segments = pathLike.split(/[\\/]/u).filter(Boolean);
+  return segments.at(-1) ?? pathLike;
+}
+
+function sanitizePathSegment(value: string): string {
+  const sanitized = value
+    .replaceAll("\0", "-")
+    .replace(/[^A-Za-z0-9._-]+/gu, "-")
+    .replace(/^-+/u, "")
+    .replace(/-+$/u, "");
+  return sanitized || "attachment";
+}
