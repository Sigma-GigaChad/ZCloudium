new file mode 100644
index 0000000..c98cb49
--- /dev/null
+++ b/packages/server/src/remote/sshDockerBackend.ts
@@ -0,0 +1,198 @@
+import { createReadStream } from "node:fs";
+import { stat } from "node:fs/promises";
+import { Emitter } from "@zcode/rpc";
+import { normalizeRemoteArch, normalizeRemotePlatform } from "@zcode/server/remote/detectEnv.js";
+import { quotePosixShellArg } from "@zcode/server/remote/posixShell.js";
+import {
+  type RemoteDisconnectEvent,
+  type RemoteEnvironment,
+  type RemoteUploadOptions,
+  type StdioStream,
+  type IRemoteBackend,
+} from "./backend.js";
+import { SSHBackend, type SSHBackendOptions } from "./ssh-backend.js";
+
+export interface SshDockerBackendOptions extends SSHBackendOptions {
+  /** Name or id of an already running container on the SSH host. */
+  container: string;
+}
+
+/**
+ * Run the remote runtime inside a Docker container on an SSH host.
+ *
+ * This is what a "cloud environment" is: the agent works in a disposable
+ * container on the machine instead of on the machine itself. The transport is
+ * the operator's SSH connection; every command is prefixed with
+ * `docker exec -i <container>`, so the container needs no sshd, no port has to
+ * be published, and no Docker credentials ever reach the machine running this
+ * server — the operator's SSH right on the host is the only key involved.
+ */
+export class SshDockerBackend implements IRemoteBackend {
+  private readonly ssh: SSHBackend;
+  private readonly container: string;
+  private homeDirPromise: Promise<string> | null = null;
+  private readonly disconnectEmitter = new Emitter<RemoteDisconnectEvent>();
+  readonly onDidDisconnect = this.disconnectEmitter.event;
+
+  constructor(options: SshDockerBackendOptions) {
+    this.container = options.container;
+    const { container: _container, ...sshOptions } = options;
+    this.ssh = new SSHBackend(sshOptions);
+    this.ssh.onDidDisconnect?.((event) => this.disconnectEmitter.fire(event));
+  }
+
+  async detect(): Promise<RemoteEnvironment> {
+    const platform = normalizeRemotePlatform(await this.execSimple("uname -s"));
+    const arch = normalizeRemoteArch(await this.execSimple("uname -m"));
+    return { platform, arch };
+  }
+
+  async upload(localPath: string, remotePath: string, options?: RemoteUploadOptions): Promise<void> {
+    if (options?.signal?.aborted) {
+      const error = new Error("Remote upload canceled");
+      error.name = "AbortError";
+      throw error;
+    }
+    const resolved = await this.resolveLinuxPath(remotePath);
+    const parentDir = this.dirname(resolved);
+    await this.execSimple(`mkdir -p ${quotePosixShellArg(parentDir)}`);
+    await this.uploadViaExec(localPath, resolved, options ?? {});
+  }
+
+  async exec(command: string): Promise<StdioStream> {
+    return this.ssh.exec(this.wrapCommand(command));
+  }
+
+  async exists(remotePath: string): Promise<boolean> {
+    try {
+      const resolved = await this.resolveLinuxPath(remotePath);
+      const result = await this.execSimple(`test -f ${quotePosixShellArg(resolved)} && printf OK`);
+      return result.trim() === "OK";
+    } catch {
+      return false;
+    }
+  }
+
+  async readFile(remotePath: string): Promise<string> {
+    const resolved = await this.resolveLinuxPath(remotePath);
+    return this.execSimple(`cat ${quotePosixShellArg(resolved)}`);
+  }
+
+  dispose(): void {
+    this.ssh.dispose();
+  }
+
+  /** The command the deploy flow wants, redirected into the container. */
+  private wrapCommand(command: string): string {
+    return `docker exec -i ${quotePosixShellArg(this.container)} /bin/sh -lc ${quotePosixShellArg(command)}`;
+  }
+
+  private async resolveLinuxPath(remotePath: string): Promise<string> {
+    if (remotePath === "~" || remotePath.startsWith("~/")) {
+      const homeDir = await this.resolveHomeDir();
+      return remotePath === "~" ? homeDir : `${homeDir.replace(/\/$/, "")}/${remotePath.slice(2)}`;
+    }
+    return remotePath;
+  }
+
+  private resolveHomeDir(): Promise<string> {
+    this.homeDirPromise ??= this.execSimple("printf %s ~").then((value) => value.trim());
+    return this.homeDirPromise;
+  }
+
+  private dirname(remotePath: string): string {
+    const normalized = remotePath.replace(/\/+/g, "/");
+    const lastSlash = normalized.lastIndexOf("/");
+    if (lastSlash <= 0) {
+      return "/";
+    }
+    return normalized.slice(0, lastSlash);
+  }
+
+  private execSimple(command: string): Promise<string> {
+    return new Promise((resolve, reject) => {
+      void this.exec(command).then(async (stream) => {
+        let stdout = "";
+        let stderr = "";
+        stream.stdout.on("data", (chunk: Buffer) => {
+          stdout += chunk.toString();
+        });
+        stream.stderr.on("data", (chunk: Buffer) => {
+          stderr += chunk.toString();
+        });
+        const code = await new Promise<number>((resolveClose) => {
+          const subscription = stream.onClose((value) => {
+            subscription.dispose();
+            resolveClose(value);
+          });
+        });
+        if (code !== 0) {
+          reject(new Error(stderr.trim() || `command failed with exit code ${code}`));
+          return;
+        }
+        resolve(stdout);
+      }, reject);
+    });
+  }
+
+  /** Stream a local file into the container through stdin, like DockerBackend does. */
+  private async uploadViaExec(
+    localPath: string,
+    remotePath: string,
+    options: RemoteUploadOptions,
+  ): Promise<void> {
+    const totalBytes = await stat(localPath).then((value) => value.size);
+    const stream = await this.exec(`cat > ${quotePosixShellArg(remotePath)}`);
+    await new Promise<void>((resolve, reject) => {
+      const readStream = createReadStream(localPath);
+      const stdin = stream.stdin;
+      let stderrText = "";
+      let settled = false;
+      const onStderr = (chunk: Buffer) => {
+        stderrText = `${stderrText}${chunk.toString()}`.slice(-2048);
+      };
+      stream.stderr.on("data", onStderr);
+      const finishError = (error: Error) => {
+        if (settled) return;
+        settled = true;
+        options.signal?.removeEventListener("abort", abort);
+        stream.stderr.removeListener("data", onStderr);
+        readStream.destroy();
+        (stdin as unknown as { destroy?: (error?: Error) => void }).destroy?.(error);
+        reject(error);
+      };
+      const abort = () => {
+        const error = new Error("Remote upload canceled");
+        error.name = "AbortError";
+        finishError(error);
+      };
+      options.signal?.addEventListener("abort", abort, { once: true });
+      readStream.on("data", (chunk: Buffer) => {
+        options.onProgress?.({ uploadedBytes: readStream.bytesRead, totalBytes });
+      });
+      readStream.on("error", finishError);
+      stdin.on("error", finishError);
+      const subscription = stream.onClose((code) => {
+        subscription.dispose();
+        if (settled) return;
+        settled = true;
+        options.signal?.removeEventListener("abort", abort);
+        stream.stderr.removeListener("data", onStderr);
+        if (code !== 0) {
+          const stderrSummary = stderrText.trim();
+          reject(
+            new Error(
+              stderrSummary
+                ? `upload failed with exit code ${code}: ${stderrSummary}`
+                : `upload failed with exit code ${code}`,
+            ),
+          );
+          return;
+        }
+        options.onProgress?.({ uploadedBytes: totalBytes, totalBytes });
+        resolve();
+      });
+      readStream.pipe(stdin);
+    });
+  }
+}
