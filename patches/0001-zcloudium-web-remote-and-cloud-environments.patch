new file mode 100644
index 0000000..a08a592
--- /dev/null
+++ b/packages/server/src/cloudEnvironments.ts
@@ -0,0 +1,278 @@
+import type { Hono } from "hono";
+import { formatZodError, sshConnectOptionsSchema } from "@zcode/shared";
+import { quotePosixShellArg } from "@zcode/server/remote/posixShell.js";
+import { SSHBackend } from "@zcode/server/remote/ssh-backend.js";
+
+/** The default base image a new cloud environment boots from. */
+export const DEFAULT_CLOUD_ENVIRONMENT_IMAGE = "ubuntu:26.04";
+
+const CONTAINER_NAME_PATTERN = /^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/;
+
+interface ProvisionRequest {
+  ssh: {
+    host: string;
+    port?: number;
+    username: string;
+    password?: string;
+    privateKeyPath?: string;
+    privateKeyPassphrase?: string;
+  };
+  name?: unknown;
+  image?: unknown;
+  setupScript?: unknown;
+  installGhCredentials?: unknown;
+}
+
+/**
+ * Cloud environments: disposable dev containers on a machine the operator
+ * reaches over SSH.
+ *
+ * The endpoint provisions a container on the host (default Ubuntu 26.04), runs
+ * the caller's setup script inside it — where the agent later installs every
+ * dependency it needs — copies the host's GitHub CLI credentials in, and hands
+ * back the container name. The caller then connects with an SSH target whose
+ * `dockerContainer` is that name, so the runtime the agent talks to lives
+ * inside the container while the only transport is the operator's SSH session.
+ * Nothing here needs Docker credentials on the machine running this server.
+ */
+export function registerCloudEnvironmentRoutes(app: Hono): void {
+  app.post("/api/cloud-environments", async (c) => {
+    const rawBody = await c.req.json().catch(() => null);
+    if (!rawBody || typeof rawBody !== "object") {
+      return c.json({ error: "Invalid request body" }, 400);
+    }
+    const body = rawBody as ProvisionRequest;
+    const parsedSsh = sshConnectOptionsSchema.safeParse({ kind: "ssh", ...body.ssh });
+    if (!parsedSsh.success) {
+      return c.json({ error: `Invalid ssh target: ${formatZodError(parsedSsh.error)}` }, 400);
+    }
+    const ssh = parsedSsh.data;
+    if (ssh.dockerContainer) {
+      return c.json({ error: "ssh target must not carry dockerContainer" }, 400);
+    }
+
+    const name = asOptionalString(body.name);
+    if (name && !CONTAINER_NAME_PATTERN.test(name)) {
+      return c.json({ error: `Invalid environment name: ${name}` }, 400);
+    }
+    const image = asOptionalString(body.image) ?? DEFAULT_CLOUD_ENVIRONMENT_IMAGE;
+    const setupScript = asOptionalString(body.setupScript);
+    const installGhCredentials = body.installGhCredentials !== false;
+
+    const containerName = name ?? `zc-env-${Date.now().toString(36)}`;
+    const backend = new SSHBackend({
+      host: ssh.host,
+      port: ssh.port,
+      username: ssh.username,
+      password: ssh.password,
+      privateKeyPath: ssh.privateKeyPath,
+      privateKeyPassphrase: ssh.privateKeyPassphrase,
+    });
+
+    try {
+      const { ghCredentials } = await provisionEnvironment(backend, {
+        containerName,
+        image,
+        setupScript,
+        installGhCredentials,
+      });
+      return c.json({ container: containerName, image, ghCredentials });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return c.json({ error: message }, 500);
+    } finally {
+      backend.dispose();
+    }
+  });
+
+  app.delete("/api/cloud-environments/:name", async (c) => {
+    const name = c.req.param("name");
+    if (!CONTAINER_NAME_PATTERN.test(name)) {
+      return c.json({ error: `Invalid environment name: ${name}` }, 400);
+    }
+    const rawBody = await c.req.json().catch(() => ({}));
+    const body = (rawBody ?? {}) as ProvisionRequest;
+    const parsedSsh = sshConnectOptionsSchema.safeParse({ kind: "ssh", ...body.ssh });
+    if (!parsedSsh.success) {
+      return c.json({ error: `Invalid ssh target: ${formatZodError(parsedSsh.error)}` }, 400);
+    }
+    const ssh = parsedSsh.data;
+    const backend = new SSHBackend({
+      host: ssh.host,
+      port: ssh.port,
+      username: ssh.username,
+      password: ssh.password,
+      privateKeyPath: ssh.privateKeyPath,
+      privateKeyPassphrase: ssh.privateKeyPassphrase,
+    });
+    try {
+      await runDocker(backend, ["rm", "-f", quotePosixShellArg(name)]);
+      return c.json({ ok: true });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return c.json({ error: message }, 500);
+    } finally {
+      backend.dispose();
+    }
+  });
+}
+
+function asOptionalString(value: unknown): string | undefined {
+  return typeof value === "string" && value.trim().length > 0 ? value : undefined;
+}
+
+interface ProvisionOptions {
+  containerName: string;
+  image: string;
+  setupScript?: string;
+  installGhCredentials: boolean;
+}
+
+async function provisionEnvironment(
+  backend: SSHBackend,
+  options: ProvisionOptions,
+): Promise<{ ghCredentials: boolean }> {
+  const container = quotePosixShellArg(options.containerName);
+
+  await runDocker(backend, ["version", "--format", "{{.Server.Version}}"]).catch((error) => {
+    throw new Error(`Docker is not available on the remote host: ${formatError(error)}`);
+  });
+
+  const existing = await runDocker(backend, [
+    "ps",
+    "-a",
+    "--format",
+    "{{.Names}}",
+  ]);
+  if (existing.split("\n").some((line) => line.trim() === options.containerName)) {
+    throw new Error(`A container named ${options.containerName} already exists on the host`);
+  }
+
+  await runDocker(backend, [
+    "run",
+    "-d",
+    "--restart",
+    "unless-stopped",
+    "--name",
+    container,
+    quotePosixShellArg(options.image),
+    "/bin/sh",
+    "-c",
+    "sleep infinity",
+  ]);
+
+  try {
+    if (options.setupScript) {
+      // The script installs whatever the environment needs; output is buffered
+      // and only reported when the script fails, so a clean run stays quiet.
+      await runDocker(backend, [
+        "exec",
+        container,
+        "/bin/sh",
+        "-lc",
+        quotePosixShellArg(options.setupScript),
+      ]);
+    }
+
+    const ghCredentials = options.installGhCredentials
+      ? await installGhCredentialsFromHost(backend, container)
+      : false;
+    return { ghCredentials };
+  } catch (error) {
+    // From here the container exists: a failure must not leave a
+    // half-provisioned environment behind.
+    const removed = await runDocker(backend, ["rm", "-f", container]).then(
+      () => true,
+      () => false,
+    );
+    const detail = formatError(error);
+    throw new Error(
+      removed
+        ? `Environment removed after a failed step:\n${detail}`
+        : `Provisioning failed and the environment could not be removed (docker rm -f ${options.containerName} on the host):\n${detail}`,
+    );
+  }
+}
+
+/**
+ * Copy the host's GitHub CLI credential material into the container, so the
+ * operator authenticates gh and git once per host instead of once per
+ * environment. Missing host credentials are not an error: the environment just
+ * starts without them.
+ */
+async function installGhCredentialsFromHost(
+  backend: SSHBackend,
+  container: string,
+): Promise<boolean> {
+  const hostsYml = await execSimple(
+    backend,
+    "cat ~/.config/gh/hosts.yml 2>/dev/null || true",
+  );
+  if (!hostsYml.trim()) {
+    return false;
+  }
+
+  await execStream(
+    backend,
+    `docker exec -i ${container} /bin/sh -lc 'mkdir -p ~/.config/gh && cat > ~/.config/gh/hosts.yml && chmod 600 ~/.config/gh/hosts.yml'`,
+    hostsYml,
+  );
+
+  // The credential helper routes git https pushes through gh; if git is not
+  // installed yet the setup script or a later install will pick the config up.
+  await execSimple(
+    backend,
+    `docker exec ${container} /bin/sh -lc 'command -v git >/dev/null 2>&1 && git config --global credential.helper "!gh auth git-credential" || true'`,
+  ).catch(() => {});
+  return true;
+}
+
+function formatError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+/** docker CLI invocation over the SSH connection; argv stays an array, only the container name is shell-quoted. */
+async function runDocker(backend: SSHBackend, args: string[]): Promise<string> {
+  return execSimple(backend, `docker ${args.join(" ")}`);
+}
+
+async function execSimple(backend: SSHBackend, command: string): Promise<string> {
+  const stream = await backend.exec(command);
+  return await collect(stream);
+}
+
+async function execStream(
+  backend: SSHBackend,
+  command: string,
+  stdin: string,
+): Promise<void> {
+  const stream = await backend.exec(command);
+  stream.stdin.write(stdin);
+  stream.stdin.end();
+  await collect(stream);
+}
+
+async function collect(stream: {
+  stdout: NodeJS.ReadableStream;
+  stderr: NodeJS.ReadableStream;
+  onClose: { (listener: (code: number) => void): { dispose(): void } };
+}): Promise<string> {
+  return new Promise((resolve, reject) => {
+    let stdout = "";
+    let stderr = "";
+    stream.stdout.on("data", (chunk: Buffer) => {
+      stdout += chunk.toString();
+    });
+    stream.stderr.on("data", (chunk: Buffer) => {
+      stderr += chunk.toString();
+    });
+    const subscription = stream.onClose((code) => {
+      subscription.dispose();
+      if (code !== 0) {
+        reject(new Error(stderr.trim() || `command failed with exit code ${code}`));
+        return;
+      }
+      resolve(stdout);
+    });
+  });
+}
