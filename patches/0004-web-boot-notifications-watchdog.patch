new file mode 100644
index 00000000..619a539d
--- /dev/null
+++ b/packages/web/src/taskNotifications.ts
@@ -0,0 +1,183 @@
+/**
+ * Web task notifications (zcloudium #47).
+ *
+ * The desktop host owns its native notifications; the web entry bridges the
+ * same `IPlatformService` contract onto the browser Notification API:
+ * - permission is requested once, on the first user gesture, and only while
+ *   the permission is still `default` (browsers reject automatic prompts);
+ * - clicking a shown notification focuses the window and routes to the task;
+ * - unread counts feed `navigator.setAppBadge` when the browser exposes it.
+ */
+import type { TaskNotificationPayload } from "@zcode/shared";
+
+export interface TaskNotificationInstance {
+  onclick: (() => void) | null;
+}
+
+export interface TaskNotificationApi {
+  getPermission: () => NotificationPermission;
+  requestPermission: () => Promise<NotificationPermission>;
+  create: (title: string, options?: NotificationOptions) => TaskNotificationInstance;
+}
+
+export interface AppBadgeApi {
+  set: (count: number) => void;
+  clear: () => void;
+}
+
+export interface NavigatorBadgeLike {
+  setAppBadge?: (contents?: number) => Promise<unknown>;
+  clearAppBadge?: () => Promise<unknown>;
+}
+
+export interface TaskNotificationsEnvironment {
+  /** Notification API; undefined when the browser does not expose it. */
+  notification?: TaskNotificationApi;
+  /** true when the tab is in the foreground — no notification is shown. */
+  isForeground: () => boolean;
+  /** Brings the tab back to the front when a notification is clicked. */
+  focusWindow: () => void;
+  /** Optional chime played alongside a shown notification. */
+  playSound?: () => void;
+  /** Unread-count badge; undefined when the browser exposes no badge API. */
+  badge?: AppBadgeApi;
+}
+
+export interface TaskNotifications {
+  showNotification: (payload: TaskNotificationPayload) => void;
+  onTaskNotificationClick: (handler: (taskId: string) => void) => () => void;
+  syncUnreadCount: (count: number) => void;
+}
+
+const PERMISSION_GESTURE_EVENTS = ["pointerdown", "keydown"] as const;
+
+/** Browser `Notification` global adapted to {@link TaskNotificationApi}. */
+export function resolveBrowserNotificationApi(): TaskNotificationApi | undefined {
+  if (typeof window === "undefined" || typeof window.Notification === "undefined") {
+    return undefined;
+  }
+  return {
+    getPermission: () => window.Notification.permission,
+    requestPermission: () => window.Notification.requestPermission(),
+    create: (title, options) =>
+      new window.Notification(title, options) as unknown as TaskNotificationInstance,
+  };
+}
+
+/**
+ * Requests notification permission exactly once, on the first user gesture,
+ * and only if the permission is still `default` at that moment. Returns a
+ * disposer that detaches the gesture listeners.
+ */
+export function requestNotificationPermissionOnFirstGesture(options: {
+  api?: TaskNotificationApi;
+  target: EventTarget;
+  events?: readonly string[];
+}): () => void {
+  const events = options.events ?? PERMISSION_GESTURE_EVENTS;
+  if (!options.api) {
+    return () => {};
+  }
+  // Hoisted functions below break the narrowing of `options.api`, so pin the
+  // checked reference once here.
+  const api = options.api;
+  let done = false;
+
+  function dispose(): void {
+    if (done) {
+      return;
+    }
+    done = true;
+    for (const event of events) {
+      options.target.removeEventListener(event, onGesture);
+    }
+  }
+
+  function onGesture(): void {
+    if (done) {
+      return;
+    }
+    // One-shot: even a gesture that decides nothing (permission already
+    // granted/denied) consumes the only request attempt.
+    dispose();
+    // Re-read at gesture time: the permission may have changed since boot.
+    if (api.getPermission() !== "default") {
+      return;
+    }
+    void api.requestPermission().catch(() => {});
+  }
+
+  for (const event of events) {
+    options.target.addEventListener(event, onGesture);
+  }
+  return dispose;
+}
+
+/** Web implementation of the platform task-notification contract. */
+export function createTaskNotifications(env: TaskNotificationsEnvironment): TaskNotifications {
+  let clickHandler: ((taskId: string) => void) | null = null;
+
+  return {
+    showNotification(payload) {
+      // A foreground tab already shows the in-app state; no duplicated banner.
+      if (env.isForeground()) {
+        return;
+      }
+      const api = env.notification;
+      if (!api || api.getPermission() !== "granted") {
+        return;
+      }
+      try {
+        const notification = api.create(payload.title, {
+          body: payload.body,
+          silent: true,
+        });
+        notification.onclick = () => {
+          env.focusWindow();
+          clickHandler?.(payload.taskId);
+        };
+        env.playSound?.();
+      } catch {
+        // The browser can still refuse the constructor; stay silent.
+      }
+    },
+    onTaskNotificationClick(handler) {
+      clickHandler = handler;
+      return () => {
+        if (clickHandler === handler) {
+          clickHandler = null;
+        }
+      };
+    },
+    syncUnreadCount(count) {
+      if (!env.badge) {
+        return;
+      }
+      if (count > 0) {
+        env.badge.set(count);
+      } else {
+        env.badge.clear();
+      }
+    },
+  };
+}
+
+/** `navigator.setAppBadge`/`clearAppBadge` adapted to {@link AppBadgeApi}. */
+export function resolveNavigatorAppBadge(
+  nav: NavigatorBadgeLike | undefined = typeof navigator === "undefined" ? undefined : navigator,
+): AppBadgeApi | undefined {
+  if (!nav || typeof nav.setAppBadge !== "function") {
+    return undefined;
+  }
+  const setAppBadge = nav.setAppBadge.bind(nav);
+  const clearAppBadge =
+    typeof nav.clearAppBadge === "function" ? nav.clearAppBadge.bind(nav) : undefined;
+  return {
+    set(count) {
+      void setAppBadge(count).catch(() => {});
+    },
+    clear() {
+      void clearAppBadge?.().catch(() => {});
+    },
+  };
+}
