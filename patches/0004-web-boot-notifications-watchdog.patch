@@ -0,0 +1,53 @@
+/**
+ * Web boot sequencing (zcloudium #47).
+ *
+ * The WebSocket URL only depends on the query string and the page origin, so
+ * it resolves synchronously — without waiting for `/api/server-info`. The boot
+ * therefore opens the socket and fetches server-info in parallel instead of
+ * chaining one after the other (one round trip less on every cold load).
+ */
+
+export interface WebSocketLocationLike {
+  protocol: string;
+  host: string;
+}
+
+/** `ws://` or `wss://` origin derived from the page location. */
+export function resolveBootWebSocketOrigin(location: WebSocketLocationLike): string {
+  return `${location.protocol === "https:" ? "wss:" : "ws:"}//${location.host}`;
+}
+
+/** Main channel URL; `?remote=` attaches straight to a remote session. */
+export function resolveBootWebSocketUrl(
+  location: WebSocketLocationLike,
+  remoteId: string | null,
+): string {
+  const base = `${resolveBootWebSocketOrigin(location)}/ws`;
+  return remoteId ? `${base}/remote/${remoteId}` : base;
+}
+
+export interface ParallelWebBootOptions<Bootstrap, Services> {
+  /** Starts the `/api/server-info` fetch. */
+  loadBootstrap: () => Promise<Bootstrap>;
+  /** Opens the socket; invoked immediately, without awaiting loadBootstrap. */
+  openSocket: () => Promise<Services>;
+}
+
+export interface ParallelWebBootResult<Bootstrap, Services> {
+  bootstrap: Bootstrap;
+  services: Services;
+}
+
+/**
+ * Starts both boot tasks without waiting for one another and returns their
+ * results together. Both are started before the first `await`: the socket
+ * opens while the server-info fetch is still in flight.
+ */
+export async function bootWebSocketInParallel<Bootstrap, Services>(
+  options: ParallelWebBootOptions<Bootstrap, Services>,
+): Promise<ParallelWebBootResult<Bootstrap, Services>> {
+  const bootstrapPromise = options.loadBootstrap();
+  const servicesPromise = options.openSocket();
+  const [bootstrap, services] = await Promise.all([bootstrapPromise, servicesPromise]);
+  return { bootstrap, services };
+}
