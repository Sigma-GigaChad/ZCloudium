diff --git a/packages/web/test/bootSocket.test.ts b/packages/web/test/bootSocket.test.ts
new file mode 100644
index 00000000..e708af36
--- /dev/null
+++ b/packages/web/test/bootSocket.test.ts
@@ -0,0 +1,131 @@
+/**
+ * Web boot sequencing (zcloudium #47): the WebSocket URL is resolved from the
+ * query string alone, and the socket opens in parallel with the
+ * `/api/server-info` fetch instead of being chained after it.
+ */
+import { describe, expect, it } from "vitest";
+import { bootWebSocketInParallel, resolveBootWebSocketUrl } from "../src/bootSocket.ts";
+
+interface Deferred<T> {
+  promise: Promise<T>;
+  resolve: (value: T) => void;
+  reject: (reason?: unknown) => void;
+}
+
+function createDeferred<T>(): Deferred<T> {
+  let resolve!: (value: T) => void;
+  let reject!: (reason?: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+function flushMicrotasks(): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+describe("resolveBootWebSocketUrl", () => {
+  it("resolves /ws on ws:// for http locations", () => {
+    expect(resolveBootWebSocketUrl({ protocol: "http:", host: "example.test:3030" }, null)).toBe(
+      "ws://example.test:3030/ws",
+    );
+  });
+
+  it("upgrades to wss:// for https locations", () => {
+    expect(resolveBootWebSocketUrl({ protocol: "https:", host: "example.test" }, null)).toBe(
+      "wss://example.test/ws",
+    );
+  });
+
+  it("routes a ?remote= attachment to /ws/remote/<id>", () => {
+    expect(
+      resolveBootWebSocketUrl({ protocol: "https:", host: "example.test" }, "ticket-123"),
+    ).toBe("wss://example.test/ws/remote/ticket-123");
+  });
+});
+
+describe("bootWebSocketInParallel", () => {
+  it("opens the socket before the server-info fetch resolves", async () => {
+    const started: string[] = [];
+    const bootstrap = createDeferred<string>();
+    const socket = createDeferred<number>();
+
+    const bootPromise = bootWebSocketInParallel({
+      loadBootstrap: () => {
+        started.push("bootstrap");
+        return bootstrap.promise;
+      },
+      openSocket: () => {
+        started.push("socket");
+        return socket.promise;
+      },
+    });
+
+    // The socket is already open while server-info is still in flight; with the
+    // sequential boot `socket` would not appear here yet.
+    expect(started).toEqual(["bootstrap", "socket"]);
+
+    let settled = false;
+    void bootPromise.then(() => {
+      settled = true;
+    });
+    socket.resolve(7);
+    await flushMicrotasks();
+    expect(settled).toBe(false);
+
+    bootstrap.resolve("info");
+    await expect(bootPromise).resolves.toEqual({ bootstrap: "info", services: 7 });
+  });
+
+  it("resolves with both results whatever the settlement order", async () => {
+    const bootstrap = createDeferred<{ instanceName: string }>();
+    const socket = createDeferred<{ onClose: () => void }>();
+    const services = { onClose: () => {} };
+
+    const bootPromise = bootWebSocketInParallel({
+      loadBootstrap: () => bootstrap.promise,
+      openSocket: () => socket.promise,
+    });
+
+    bootstrap.resolve({ instanceName: "instance-a" });
+    socket.resolve(services);
+
+    await expect(bootPromise).resolves.toEqual({
+      bootstrap: { instanceName: "instance-a" },
+      services,
+    });
+  });
+
+  it("rejects as soon as the socket fails, without waiting for the fetch", async () => {
+    const bootstrap = createDeferred<string>();
+    const socket = createDeferred<number>();
+
+    const bootPromise = bootWebSocketInParallel({
+      loadBootstrap: () => bootstrap.promise,
+      openSocket: () => socket.promise,
+    });
+
+    socket.reject(new Error("socket failed"));
+
+    await expect(bootPromise).rejects.toThrow("socket failed");
+    // The abandoned bootstrap promise must not turn into an unhandled rejection.
+    bootstrap.resolve("late");
+  });
+
+  it("rejects as soon as the fetch fails, without waiting for the socket", async () => {
+    const bootstrap = createDeferred<string>();
+    const socket = createDeferred<number>();
+
+    const bootPromise = bootWebSocketInParallel({
+      loadBootstrap: () => bootstrap.promise,
+      openSocket: () => socket.promise,
+    });
+
+    bootstrap.reject(new Error("server-info failed"));
+
+    await expect(bootPromise).rejects.toThrow("server-info failed");
+    socket.resolve(1);
+  });
+});
diff --git a/packages/web/test/taskNotifications.test.ts b/packages/web/test/taskNotifications.test.ts
new file mode 100644
index 00000000..de33eaa0
--- /dev/null
+++ b/packages/web/test/taskNotifications.test.ts
@@ -0,0 +1,253 @@
+/**
+ * Task notifications (zcloudium #47): permission is requested once, on the
+ * first user gesture, and only while the permission is still `default`;
+ * clicking a notification focuses the window and routes to the task.
+ */
+import { describe, expect, it, vi } from "vitest";
+import type { TaskNotificationPayload } from "@zcode/shared";
+import {
+  createTaskNotifications,
+  requestNotificationPermissionOnFirstGesture,
+  resolveNavigatorAppBadge,
+  type TaskNotificationApi,
+  type TaskNotificationInstance,
+} from "../src/taskNotifications.ts";
+
+interface FakeNotificationInstance extends TaskNotificationInstance {
+  title: string;
+  options?: NotificationOptions;
+}
+
+function createFakeNotificationApi(initialPermission: NotificationPermission = "granted") {
+  let permission = initialPermission;
+  const instances: FakeNotificationInstance[] = [];
+  const requestPermission = vi.fn(async () => permission);
+  const api: TaskNotificationApi = {
+    getPermission: () => permission,
+    requestPermission,
+    create: (title, options) => {
+      const instance: FakeNotificationInstance = { title, options, onclick: null };
+      instances.push(instance);
+      return instance;
+    },
+  };
+  return {
+    api,
+    instances,
+    requestPermission,
+    setPermission: (next: NotificationPermission) => {
+      permission = next;
+    },
+  };
+}
+
+function taskPayload(overrides: Partial<TaskNotificationPayload> = {}): TaskNotificationPayload {
+  return {
+    taskId: "task-1",
+    status: "completed",
+    title: "Task completed",
+    body: "All checks passed",
+    ...overrides,
+  };
+}
+
+describe("requestNotificationPermissionOnFirstGesture", () => {
+  it("requests permission once, on the first gesture, while permission is default", () => {
+    const target = new EventTarget();
+    const fake = createFakeNotificationApi("default");
+
+    requestNotificationPermissionOnFirstGesture({ api: fake.api, target });
+
+    // Nothing is requested before a real gesture: browsers reject automatic prompts.
+    expect(fake.requestPermission).not.toHaveBeenCalled();
+
+    target.dispatchEvent(new Event("pointerdown"));
+    expect(fake.requestPermission).toHaveBeenCalledTimes(1);
+
+    // One-shot: later gestures do not prompt again.
+    target.dispatchEvent(new Event("keydown"));
+    expect(fake.requestPermission).toHaveBeenCalledTimes(1);
+  });
+
+  it("never requests permission when the browser already decided", () => {
+    for (const permission of ["granted", "denied"] as const) {
+      const target = new EventTarget();
+      const fake = createFakeNotificationApi(permission);
+
+      requestNotificationPermissionOnFirstGesture({ api: fake.api, target });
+      target.dispatchEvent(new Event("pointerdown"));
+
+      expect(fake.requestPermission).not.toHaveBeenCalled();
+    }
+  });
+
+  it("re-checks the permission at gesture time", () => {
+    const target = new EventTarget();
+    const fake = createFakeNotificationApi("default");
+
+    requestNotificationPermissionOnFirstGesture({ api: fake.api, target });
+    fake.setPermission("granted");
+    target.dispatchEvent(new Event("pointerdown"));
+
+    expect(fake.requestPermission).not.toHaveBeenCalled();
+  });
+
+  it("stops listening after dispose", () => {
+    const target = new EventTarget();
+    const fake = createFakeNotificationApi("default");
+
+    const dispose = requestNotificationPermissionOnFirstGesture({ api: fake.api, target });
+    dispose();
+    target.dispatchEvent(new Event("pointerdown"));
+
+    expect(fake.requestPermission).not.toHaveBeenCalled();
+  });
+
+  it("does nothing when the browser exposes no Notification API", () => {
+    const target = new EventTarget();
+
+    expect(() => {
+      requestNotificationPermissionOnFirstGesture({ api: undefined, target });
+      target.dispatchEvent(new Event("pointerdown"));
+    }).not.toThrow();
+  });
+});
+
+describe("createTaskNotifications", () => {
+  it("focuses the window and routes to the task on notification click", () => {
+    const fake = createFakeNotificationApi();
+    const focusWindow = vi.fn();
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => false,
+      focusWindow,
+    });
+    const routeToTask = vi.fn();
+    notifications.onTaskNotificationClick(routeToTask);
+
+    notifications.showNotification(taskPayload({ taskId: "task-42" }));
+
+    expect(fake.instances).toHaveLength(1);
+    expect(fake.instances[0]?.title).toBe("Task completed");
+    expect(fake.instances[0]?.options).toMatchObject({
+      body: "All checks passed",
+      silent: true,
+    });
+
+    // The browser delivers the click through the native notification's onclick.
+    fake.instances[0]?.onclick?.();
+
+    expect(focusWindow).toHaveBeenCalledTimes(1);
+    expect(routeToTask).toHaveBeenCalledWith("task-42");
+  });
+
+  it("still focuses the window when no click handler is registered", () => {
+    const fake = createFakeNotificationApi();
+    const focusWindow = vi.fn();
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => false,
+      focusWindow,
+    });
+
+    notifications.showNotification(taskPayload());
+
+    expect(() => fake.instances[0]?.onclick?.()).not.toThrow();
+    expect(focusWindow).toHaveBeenCalledTimes(1);
+  });
+
+  it("stops routing after the click subscription is disposed", () => {
+    const fake = createFakeNotificationApi();
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => false,
+      focusWindow: vi.fn(),
+    });
+    const routeToTask = vi.fn();
+    const dispose = notifications.onTaskNotificationClick(routeToTask);
+
+    notifications.showNotification(taskPayload({ taskId: "task-9" }));
+    dispose();
+    fake.instances[0]?.onclick?.();
+
+    expect(routeToTask).not.toHaveBeenCalled();
+  });
+
+  it("skips notifications while the tab is focused", () => {
+    const fake = createFakeNotificationApi();
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => true,
+      focusWindow: vi.fn(),
+    });
+
+    notifications.showNotification(taskPayload());
+
+    expect(fake.instances).toHaveLength(0);
+  });
+
+  it("skips notifications when permission is not granted", () => {
+    const fake = createFakeNotificationApi("default");
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => false,
+      focusWindow: vi.fn(),
+    });
+
+    notifications.showNotification(taskPayload());
+
+    expect(fake.instances).toHaveLength(0);
+  });
+
+  it("plays the notification sound with the shown notification", () => {
+    const fake = createFakeNotificationApi();
+    const playSound = vi.fn();
+    const notifications = createTaskNotifications({
+      notification: fake.api,
+      isForeground: () => false,
+      focusWindow: vi.fn(),
+      playSound,
+    });
+
+    notifications.showNotification(taskPayload());
+
+    expect(playSound).toHaveBeenCalledTimes(1);
+  });
+
+  it("forwards unread counts to the app badge", () => {
+    const set = vi.fn();
+    const clear = vi.fn();
+    const notifications = createTaskNotifications({
+      isForeground: () => false,
+      focusWindow: vi.fn(),
+      badge: { set, clear },
+    });
+
+    notifications.syncUnreadCount(3);
+    expect(set).toHaveBeenCalledWith(3);
+    expect(clear).not.toHaveBeenCalled();
+
+    notifications.syncUnreadCount(0);
+    expect(clear).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe("resolveNavigatorAppBadge", () => {
+  it("is unavailable when the browser exposes no badge API", () => {
+    expect(resolveNavigatorAppBadge({})).toBeUndefined();
+  });
+
+  it("delegates set and clear to navigator.setAppBadge/clearAppBadge", async () => {
+    const setAppBadge = vi.fn(async () => {});
+    const clearAppBadge = vi.fn(async () => {});
+
+    const badge = resolveNavigatorAppBadge({ setAppBadge, clearAppBadge });
+
+    expect(badge).toBeDefined();
+    badge?.set(3);
+    badge?.clear();
+    await Promise.resolve();
+    expect(setAppBadge).toHaveBeenCalledWith(3);
+    expect(clearAppBadge).toHaveBeenCalledTimes(1);
+  });
+});
