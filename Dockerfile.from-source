# syntax=docker/dockerfile:1

# ZCode Web, built FROM THE UPSTREAM SOURCES.
#
# The "I build the runtime myself" path: the sources are compiled here instead
# of downloading the published tarball. Validated on the ZCodium fork's v3.14.7
# (2026-10-06): the build completes and the runtime it produces starts and
# answers /api/server-info. Cold build measured at about 5 minutes on a capable
# machine, against about 8 seconds for the precompiled path.
#
# What building from source does NOT buy, measured:
#   - the sha256 of the tarball it produces (d928ae31...) differs from the
#     official release's (81d0961f...): tarballs carry mtimes, so the build is
#     not bit for bit reproducible against the published artifact;
#   - upstream zai-org/ZCode stops at v3.14.3: every tag after that exists only
#     on the ZCodium fork, so building "only from the original vendor" means
#     staying several releases behind, and building current versions means
#     building this fork's git anyway.
#
# STATUS: the build is validated, the image it produces is NOT the product: it
# still predates the authentication gateway (no /_auth/, no TLS, no entrypoint),
# so running it publishes the runtime unauthenticated on port 3030. Wiring the
# gateway in is the remaining work, and the e2e suite would have to pass against
# it before this path could ship.
#
# glibc base is mandatory (bookworm, not alpine): the runtime package embeds the
# precompiled node-pty binaries (@lydell/node-pty-linux-x64) and no musl variant
# is published by scripts/zcode-distribution/assets.mjs.

ARG NODE_VERSION=24.14.0

FROM node:${NODE_VERSION}-bookworm AS builder

ARG ZCODE_REPO=https://github.com/zai-org/ZCode.git
ARG ZCODE_REF=v3.14.3
ARG PNPM_VERSION=10.33.2

ENV CI=1 \
    HUSKY=0 \
    COREPACK_ENABLE_PROJECT_SPEC=0 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    ZCODE_SKIP_REMOTE_ASSETS=1

# python3/make/g++: a safety net when a native dependency has no prebuilt for
# linux-x64. It exists in this stage only.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g "pnpm@${PNPM_VERSION}"

WORKDIR /src

# Fetch a single revision: accepts a tag, a branch or a SHA. `--branch` does not
# handle SHAs, hence the fetch plus FETCH_HEAD.
RUN git init -q . \
 && git remote add origin "${ZCODE_REPO}" \
 && git fetch -q --depth 1 origin "${ZCODE_REF}" \
 && git checkout -q FETCH_HEAD \
 && git submodule update --init --recursive || true

RUN pnpm install --frozen-lockfile \
 && pnpm prepare:desktop-runtime || true

# The vendor's own release workflow (ZCodium .github/workflows/release.yml) builds
# the tarball with exactly three steps: install --frozen-lockfile, then
# `pnpm typecheck`, then `pnpm build:zcode`. `typecheck` is `tsc -b` over the
# project references: it is what emits packages/shared/dist/index.js, which has no
# build script of its own and which the SEA asset collector requires. The
# build:bootstrap sequence that used to be here does not produce it, and the
# build died on "Missing @zcode/shared dist files" (measured, twice: on the fork's
# v3.14.7 and on upstream's v3.14.3, which is where that tag series stops).
RUN pnpm typecheck

# --base-url only feeds the generated install.sh, which is not used here.
# The fork's tarball is named zcodium-<version>.tar.gz (upstream named it
# zcode-*.tar.gz) and its top directory is zcodium/, so the extraction strips
# the component exactly like the precompiled path does with the official one.
RUN pnpm build:zcode --base-url https://invalid.local/zcode/ \
 && mkdir -p /out/zcode \
 && tar -xzf "$(ls dist/zcode/releases/*/*.tar.gz | head -n 1)" --strip-components=1 -C /out/zcode \
 && test -f /out/zcode/bin/zcode.mjs \
 && test -f /out/zcode/server/entry-http.js

FROM node:${NODE_VERSION}-bookworm-slim AS runtime

ARG ZCODE_REF=v3.14.3
ARG ZCODE_COMMIT=unknown

LABEL org.opencontainers.image.title="z-cloudium" \
      org.opencontainers.image.description="ZCode Web, built from zai-org/ZCode (not validated)" \
      org.opencontainers.image.version="${ZCODE_REF}" \
      org.opencontainers.image.revision="${ZCODE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/zai-org/ZCode" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl less procps \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data /workspace \
 && chown node:node /data /workspace

COPY --from=builder --chown=node:node /out/zcode /opt/zcode

ENV ZCODE_DATA_BASE_DIR=/data \
    ZCODE_SERVER_WORKSPACE=/workspace \
    ZCODE_MODEL_TELEMETRY_ENABLED=0

RUN ln -sfn /opt/zcode/bin/zcode.mjs /usr/local/bin/zcode

VOLUME ["/data"]

WORKDIR /workspace
USER node
EXPOSE 3030

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3030/api/server-info').then(r=>process.exit(r.ok||r.status===401?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "/opt/zcode/bin/zcode.mjs"]
CMD ["--web", "--host", "0.0.0.0", "--port", "3030", "--workspace", "/workspace", "--no-open", "--no-token"]
