# syntax=docker/dockerfile:1

# ZCode Web, built FROM THE UPSTREAM SOURCES (zai-org/ZCode).
#
# The "I only trust the original vendor" path: the open source snapshot is
# compiled here, without a fork and without a third party binary. The price is a
# long build (15 to 30 minutes, a few GB), with pnpm and Node present in the
# builder stage only.
#
# STATUS: this path is NOT validated. As is, it fails on
# "Missing @zcode/shared dist files": the upstream source build does not produce
# packages/shared/dist, while the SEA asset collector requires it. The
# `pnpm run build:bootstrap` step added below is the official sequence of the
# project (scripts/bootstrap.mjs) and should produce that dist, but it has not
# been verified. Using Dockerfile (precompiled runtime) is the tested path.
#
# This file also predates the authentication gateway: it does not ship the
# gateway entrypoint, and its runtime lives in /opt/zcode rather than
# /opt/zcodium. Wiring it is part of validating this path.
#
# glibc base is mandatory (bookworm, not alpine): the runtime package embeds the
# precompiled node-pty binaries (@lydell/node-pty-linux-x64) and no musl variant
# is published by scripts/zcode-distribution/assets.mjs.

ARG NODE_VERSION=24.14.0

FROM node:${NODE_VERSION}-bookworm AS builder

ARG ZCODE_REPO=https://github.com/zai-org/ZCode.git
ARG ZCODE_REF=v3.14.3
ARG PNPM_VERSION=10.33.2

ENV CI=1 \
    HUSKY=0 \
    COREPACK_ENABLE_PROJECT_SPEC=0 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    ZCODE_SKIP_REMOTE_ASSETS=1

# python3/make/g++: a safety net when a native dependency has no prebuilt for
# linux-x64. It exists in this stage only.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g "pnpm@${PNPM_VERSION}"

WORKDIR /src

# Fetch a single revision: accepts a tag, a branch or a SHA. `--branch` does not
# handle SHAs, hence the fetch plus FETCH_HEAD.
RUN git init -q . \
 && git remote add origin "${ZCODE_REPO}" \
 && git fetch -q --depth 1 origin "${ZCODE_REF}" \
 && git checkout -q FETCH_HEAD \
 && git submodule update --init --recursive || true

RUN pnpm install --frozen-lockfile \
 && pnpm prepare:desktop-runtime || true

# build:bootstrap is the official sequence of scripts/bootstrap.mjs: it builds
# every packages/* (including @zcode/shared, which build:zcode leaves out).
RUN pnpm run build:bootstrap

# --base-url only feeds the generated install.sh, which is not used here.
RUN pnpm build:zcode --base-url https://invalid.local/zcode/ \
 && mkdir -p /out \
 && tar -xzf "$(ls dist/zcode/releases/*/zcode-*.tar.gz | head -n 1)" -C /out \
 && test -f /out/zcode/bin/zcode.mjs \
 && test -f /out/zcode/server/entry-http.js

FROM node:${NODE_VERSION}-bookworm-slim AS runtime

ARG ZCODE_REF=v3.14.3
ARG ZCODE_COMMIT=unknown

LABEL org.opencontainers.image.title="z-cloudium" \
      org.opencontainers.image.description="ZCode Web, built from zai-org/ZCode (not validated)" \
      org.opencontainers.image.version="${ZCODE_REF}" \
      org.opencontainers.image.revision="${ZCODE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/zai-org/ZCode" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl less procps \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data /workspace \
 && chown node:node /data /workspace

COPY --from=builder --chown=node:node /out/zcode /opt/zcode

ENV ZCODE_DATA_BASE_DIR=/data \
    ZCODE_SERVER_WORKSPACE=/workspace \
    ZCODE_MODEL_TELEMETRY_ENABLED=0

RUN ln -sfn /opt/zcode/bin/zcode.mjs /usr/local/bin/zcode

VOLUME ["/data"]

WORKDIR /workspace
USER node
EXPOSE 3030

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3030/api/server-info').then(r=>process.exit(r.ok||r.status===401?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "/opt/zcode/bin/zcode.mjs"]
CMD ["--web", "--host", "0.0.0.0", "--port", "3030", "--workspace", "/workspace", "--no-open", "--no-token"]
